def our_work(request):
    """Reference-style Our Works gallery, fully managed through PageContentBlock."""
    categories = visible_categories(top_level=True).prefetch_related("products", active_children_prefetch())
    blocks = list(PageContentBlock.objects.filter(page="our_work", is_active=True).order_by("sort_order", "id"))
    keyed = {block.section_key: block for block in blocks}
    sections = [
        ("banners", "BANNERS & DISPLAYS"),
        ("promotional", "PROMOTIONAL PRODUCTS"),
        ("corporate", "CORPORATE GIFT SETS"),
        ("awards", "AWARDS"),
        ("marketing", "MARKETING MATERIALS"),
        ("apparel", "CUSTOM APPAREL"),
    ]
    gallery = []
    for key, default_heading in sections:
        heading = keyed.get(key + "-heading")
        images = [b for b in blocks if b.section_key.startswith(key + "-image-") and b.image]
        if heading or images:
            gallery.append({"key": key, "heading": heading.heading if heading and heading.heading else default_heading,
                            "body": heading.body if heading else "", "images": images})
    # Additional admin-created groups can use a section_key prefix such as "events-heading"/"events-image-01".
    existing_keys = {s[0] for s in sections}
    for block in blocks:
        if not block.section_key.endswith("-heading"):
            continue
        key = block.section_key[:-8]
        if key in existing_keys or key in {"services", "intro"}:
            continue
        images = [b for b in blocks if b.section_key.startswith(key + "-image-") and b.image]
        gallery.append({"key": key, "heading": block.heading, "body": block.body, "images": images})
    # Admin can add independent gallery images without manually creating a
    # matching heading record first. Respect the block's sort order.
    represented = {section["key"] for section in gallery}
    additional = {}
    for block in blocks:
        if not block.image or "-image-" not in block.section_key:
            continue
        key = block.section_key.split("-image-", 1)[0]
        if key in represented or not key:
            continue
        additional.setdefault(key, []).append(block)
    for key, images in additional.items():
        heading = keyed.get(key + "-heading")
        gallery.append({
            "key": key, "heading": (heading.heading if heading and heading.heading else key.replace("-", " ").title()),
            "body": heading.body if heading else "", "images": images,
        })
    return render(request, "designer/our_work.html", {
        "categories": categories,
        "work_hero": keyed.get("hero"),
        "work_intro": keyed.get("intro"),
        "work_gallery": gallery,
        "work_cta": keyed.get("cta"),
    })

def contact(request):
    from django.contrib import messages
    from django.core.cache import cache
    from django.core.validators import validate_email
    from django.core.exceptions import ValidationError
    from .services.store_email import active_account, send_store_email, render_store_template
    from .models import Category, ChatInquiry
    categories = Category.objects.filter(parent__isnull=True, is_active=True).order_by("sort_order", "name")
    if request.method == "POST":
        name = (request.POST.get("name") or "").strip()[:140]
        email = (request.POST.get("email") or "").strip()[:254]
        phone = (request.POST.get("phone") or "").strip()[:40]
        subject = (request.POST.get("subject") or "").strip()[:160]
        body = (request.POST.get("message") or "").strip()[:4000]
        category_id = (request.POST.get("product_category") or "").strip()
        category = categories.filter(pk=category_id).first() if category_id.isdecimal() else None
        try:
            validate_email(email)
            if not all((name, phone, subject, body)) or category is None:
                raise ValidationError("All contact fields and a valid product category are required.")
        except ValidationError:
            messages.error(request, "Please complete every field, including a valid email address and product category.")
        else:
            key = "zv_contact:" + (request.META.get("REMOTE_ADDR") or "unknown")
            if not cache.add(key, "1", timeout=60):
                messages.error(request, "Please wait a minute before sending another enquiry.")
            else:
                ChatInquiry.objects.create(
                    name=name, email=email, phone=phone,
                    message="Product category: " + category.name + "\\nSubject: " + subject + "\\n" + body,
                    page_url=request.build_absolute_uri()[:500],
                )
                account = active_account()
                if account and account.notify_on_contact:
                    try:
                        email_message = render_store_template(
                            "contact_admin", "ZenVibe contact: " + subject,
                            "From: " + name + " <" + email + ">\\nPhone: " + phone + "\\nCategory: " + category.name + "\\n\\n" + body,
                            {"customer_name": name, "customer_email": email, "phone": phone,
                             "subject": subject, "message": body, "product_category": category.name},
                        )
                        if email_message:
                            send_store_email(*email_message, [account.email_address], reply_to=email)
                    except Exception:
                        import logging
                        logging.getLogger(__name__).exception("Contact notification failed")
                messages.success(request, "Your enquiry has been received.")
                return redirect("designer:contact")
    return render(request, "designer/info_page.html", {
        "title": "Contact Us",
        "intro": "Have a product, artwork or bulk-order question? Talk to the ZenVibe team.",
        "kind": "contact",
        "managed_blocks": PageContentBlock.objects.filter(page="contact", is_active=True),
        "contact_categories": categories,
    })


