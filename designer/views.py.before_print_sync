def blog_detail(request, slug):

    post = get_object_or_404(
        BlogPost,
        slug=slug,
        is_published=True
    )

    # Only approved comments are visible publicly
    comments = BlogComment.objects.filter(
        post=post,
        is_approved=True
    ).order_by("created_at")


    # Related articles
    related = (
        BlogPost.objects
        .filter(is_published=True)
        .exclude(pk=post.pk)
        .order_by("-published_at", "-created_at")[:3]
    )


    comment_success = False
    comment_error = ""
    comment_data = {
        "name": "",
        "email": "",
        "website": "",
        "comment": "",
    }


    # ---------------------------------------------------------
    # COMMENT SUBMISSION
    # ---------------------------------------------------------

    if request.method == "POST":

        if not post.allow_comments:
            comment_error = "Comments are closed for this article."
            return render(request, "designer/blog_detail.html", {"post": post, "related_posts": related, "comments": comments, "comment_success": False, "comment_error": comment_error, "comment_data": comment_data})

        name = (request.POST.get("name") or "").strip()
