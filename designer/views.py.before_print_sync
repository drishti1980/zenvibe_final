def _add_business_days(start_date, business_days):
    """Add Monday-Friday business days. Weekends are skipped."""
    current = start_date
    remaining = max(0, int(business_days or 0))
    while remaining:
        current += timedelta(days=1)
        if current.weekday() < 5:
            remaining -= 1
    return current


def _ordinal_day(day):
    """Return 1st, 2nd, 3rd, 4th ... for storefront delivery dates."""
    if 10 <= day % 100 <= 20:
        suffix = "th"
    else:
        suffix = {1: "st", 2: "nd", 3: "rd"}.get(day % 10, "th")
    return f"{day}{suffix}"


def _format_delivery_date(value):
    return f"{value.strftime('%b')} {_ordinal_day(value.day)}, {value.year}"


def _product_fastest_delivery(product):
    """
    Per-product fastest-delivery configuration.

    Stored in Product.source_attributes so this works with the current database
    without adding a schema migration. Values are edited as normal fields in
    Django Admin by ProductAdminForm.
    """
    attrs = product.source_attributes if isinstance(product.source_attributes, dict) else {}
    enabled = bool(attrs.get("fastest_delivery_enabled", False))
    if not enabled:
        return None

    try:
        minimum = int(attrs.get("fastest_delivery_min_business_days"))
        maximum = int(attrs.get("fastest_delivery_max_business_days"))
    except (TypeError, ValueError):
        return None

    if minimum < 0 or maximum < minimum:
        return None

    today = timezone.localdate()
    earliest = _add_business_days(today, minimum)
    latest = _add_business_days(today, maximum)

    return {
        "enabled": True,
        "min_business_days": minimum,
        "max_business_days": maximum,
        "start_date": earliest,
        "end_date": latest,
        "start_label": _format_delivery_date(earliest),
        "end_label": _format_delivery_date(latest),
    }


def choose_design(request, product_id):
    product = get_object_or_404(Product, id=product_id)
    templates = live_templates_for(product)
    angle_images = list(product.angle_images.all())
    angle_image_urls = [asset_candidates(img.image.url)[0] if img.image else None for img in angle_images]
    angle_image_urls = [u for u in angle_image_urls if u]

    size_variants = list(product.size_variants.filter(is_active=True))
    color_variants = list(product.color_variants.filter(is_active=True))
    tiers = list(product.price_tiers.filter(is_active=True).select_related("variant").order_by("variant_id", "min_quantity", "id"))

    # Build display ranges from the next tier: 50-99, 100-249, 250-499, 500+.
    price_tier_rows = []
    by_variant = {}
    for tier in tiers:
        by_variant.setdefault(tier.variant_id, []).append(tier)
    for variant_id, rows in by_variant.items():
        for index, tier in enumerate(rows):
            next_min = rows[index + 1].min_quantity if index + 1 < len(rows) else None
            explicit_max = getattr(tier, "max_quantity", None)
            max_qty = explicit_max if explicit_max is not None else (next_min - 1 if next_min else None)
            price_tier_rows.append({
                "tier": tier,
                "min_quantity": tier.min_quantity,
                "max_quantity": max_qty,
                "unit_price": tier.unit_price,
                "variant_key": tier.variant.size_key if tier.variant_id else "",
            })

    return render(request, "designer/choose_design.html", {
        "product": product, "templates": templates,
        "bc_pack_templates": _business_card_db_gallery(product),
        "invitation_templates": _invitation_db_gallery(product),
        "angle_image_urls_json": json.dumps(angle_image_urls),
        "customizer_kind": customizer_kind_for(product),
        "size_variants": size_variants,
        "color_variants": color_variants,
        "option_groups": _product_option_groups(product, size_variants, color_variants),
        "price_tiers": tiers,
        "price_tier_rows": price_tier_rows,
        "effective_minimum_quantity": _effective_minimum_quantity(
            product,
            size_variants[0].size_key if size_variants else "",
        ),
        "fastest_delivery": _product_fastest_delivery(product),
    })

