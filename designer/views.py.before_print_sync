def home(request):
    # Keep the home page focused on main catalogue groups. Product counts include
    # both direct products and the products inside each immediate subcategory.
    categories = list(
        visible_categories(top_level=True)
        .prefetch_related(
            Prefetch("products", queryset=Product.objects.filter(is_active=True, is_out_of_stock=False).order_by("name")),
            active_children_prefetch(with_products=True),
        )
        .order_by("sort_order", "name")
    )
    for category in categories:
        direct_count = sum(
            1 for product in category.products.all()
            if product.is_active and not product.is_out_of_stock
        )
        child_count = sum(
            1
            for child in category.children.all()
            if child.is_active and not child.is_out_of_stock
            for product in child.products.all()
            if product.is_active and not product.is_out_of_stock
        )
        category.product_count = direct_count + child_count

    # Always query live Admin values; avoid relying on the first twelve IDs.
    products = Product.objects.filter(
        is_active=True, is_out_of_stock=False, category__is_active=True,
        image__isnull=False,
    ).exclude(image="").select_related("category").order_by("-id")[:12]
    sale_products = Product.objects.filter(
        is_active=True, is_out_of_stock=False, is_on_sale=True,
        category__is_active=True,
    ).select_related("category").order_by("sale_priority", "-id")[:12]
    return render(request, "designer/home.html", {
        "categories": categories, "products": products, "sale_products": sale_products,
        "testimonials": Testimonial.objects.filter(is_active=True)[:12],
        "brand_logos": BrandLogo.objects.filter(is_active=True)[:20],
        "home_content_blocks": PageContentBlock.objects.filter(page="home", is_active=True),
        "home_banners": HomeBanner.objects.filter(is_active=True).order_by("sort_order", "id"),
    })


