@staff_member_required
def save_template_json(request, template_id):
    if request.method != "POST":
        return HttpResponseBadRequest("POST required")

    try:
        template = get_object_or_404(DesignTemplate, id=template_id)
        payload = json.loads(request.body.decode("utf-8"))

        json_data = payload.get("json_data")

        if not isinstance(json_data, dict):
            return JsonResponse(
                {"ok": False, "error": "Invalid template JSON."}, status=400
            )

        # V12 publishing contract: customer templates must be editable masters.
        # Never let a newly imported flat bitmap masquerade as a converted design.
        if not json_data.get("reconstructed") or json_data.get("templateType") != "editable-master":
            return JsonResponse(
                {
                    "ok": False,
                    "error": "The uploaded artwork must finish conversion into editable layers before it can be published.",
                },
                status=409,
            )
        pages = json_data.get("pages") or []
        admin_pages = json_data.get("adminPages") or []
        objects = [o for page in pages if isinstance(page, dict) for o in (page.get("objects") or []) if isinstance(o, dict)]
        admin_objects = [o for page in admin_pages if isinstance(page, dict) for o in (page.get("objects") or []) if isinstance(o, dict)]
        editable = [o for o in objects if o.get("customerEditable") is not False and not o.get("backgroundAsset")]
        manual_pairs = [o for o in objects if o.get("fieldType") == "manual-replace" or o.get("manualReplacement")]
        # V42: a newly uploaded template may be published before OCR conversion;
        # explicit Remove/Replace text, added text, shapes, logos and other Fabric
        # objects are valid editable layers. Do not reject a layered master merely
        # because OCR generated zero results.
        if not editable and not manual_pairs:
            admin_editable = [o for o in admin_objects if o.get("customerEditable") is not False and not o.get("backgroundAsset")]
            if not admin_editable:
                return JsonResponse(
                    {"ok": False, "error": "Add or replace at least one editable element before publishing this template."},
                    status=409,
                )

        # V55 stable: keep image data URLs inside the master JSON. This makes the
        # published design independent of MEDIA_URL/application prefixes and avoids
        # blank canvases after deployment moves. Existing media URLs are still read.
        template.json_data = json_data

        preview_png = payload.get("preview_png", "")

        if preview_png and preview_png.startswith("data:image"):
            try:
                header, encoded_image = preview_png.split(",", 1)
                image_data = base64.b64decode(encoded_image)

                filename = f"template-{template.id}-preview.png"

                template.preview.save(
                    filename,
                    ContentFile(image_data),
                    save=False,
                )
            except (ValueError, TypeError, base64.binascii.Error):
                return JsonResponse(
                    {
                        "ok": False,
                        "error": "The generated preview image is invalid.",
                    },
                    status=400,
                )

        template.save()

        return JsonResponse(
            {
                "ok": True,
                "message": "Template saved successfully.",
                "template_id": template.id,
                "preview_url": (
                    template.preview.url
                    if template.preview
                    else ""
                ),
            }
        )

    except Exception as exc:
        return JsonResponse(
            {
                "ok": False,
                "error": str(exc),
            },
            status=400,
        )
        
