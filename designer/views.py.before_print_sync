def editor(request, product_id):
    # Legacy Promotional import IDs are no longer sellable products. Keep old
    # bookmarks/links working by redirecting them to their canonical catalogue
    # records instead of rendering a dead editor.
    promotional_redirects = {
        63: 479,   # old generic keychain -> Premium Heavy Duty Custom Keychain
        163: 479,  # corrupted heavy-duty keychain import/address record
        164: 427,  # Badge1 -> Custom Name Badge
        165: 419,  # Car Freshener Back -> Custom Car Freshener
        166: 475,  # Cart Token -> Shopping Cart Coin Keychain
        167: 428,  # old office door sign
        252: 421,  # old full-colour lanyard
    }
    canonical_id = promotional_redirects.get(int(product_id))
    if canonical_id:
        query = request.GET.urlencode()
        target = reverse("designer:editor", args=[canonical_id])
        return redirect(f"{target}?{query}" if query else target)

    # Use the exact product selected on the storefront. Some legacy catalogue
    # products are still shown by the existing UI even when their is_active flag
    # is false, so do not turn a valid storefront Customize link into a 404.
    product = get_object_or_404(Product, id=product_id)
    template_id = request.GET.get("template")
    design_id = request.GET.get("design")
    template = None
    template_json = {}
    template_image = ""
    existing_design = None
    pack_code = request.GET.get("pack")

    # UNIVERSAL DEFAULT TEMPLATE:
    # Main Customize -> first active editable template for this product.
    # Explicit template/design/pack/blank requests keep existing behaviour.
    explicit_blank = (request.GET.get("mode") or "").strip().lower() == "blank"
    if not template_id and not design_id and not pack_code and not explicit_blank:
        product_templates = live_templates_for(product)
        if product_templates:
            template_id = str(product_templates[0].id)

    if pack_code and not design_id and not template_id:
        packed = _load_business_card_pack(pack_code)
        if packed:
            template_json = packed

    if design_id:
        candidate = get_object_or_404(SavedDesign, id=design_id, product=product)
        if _can_access(request, candidate):
            existing_design = candidate
            template_json = _inline_template_media_urls(json.loads(json.dumps(candidate.design_json or {})))
    elif template_id:
        # Template libraries are replaceable. A browser/bookmark may still carry
        # an ID from the previous generator after --replace. Do not 404 the whole
        # editor: fall back to the first current live template for this product.
        try:
            template = _get_template_for_product(template_id, product)
        except Http404:
            current_templates = live_templates_for(product)
            if not current_templates:
                raise
            template = current_templates[0]
        template_json = _inline_template_media_urls(json.loads(json.dumps(template.json_data or {})))
        if template.preview:
            template_image = template.preview.url

    product_options = _editor_product_options(product, request, existing_design)

    # Restricted product editors (Awards, Drinkware, etc.) are product-first:
    # the locked Product.image is the physical blank/reference and templates are
    # customer artwork only. Never allow a flattened template/master image to
    # replace the product reference.
    editor_cfg = product_options.get("editor_config") or {}
    if editor_cfg.get("enabled") and editor_cfg.get("mode") == "print_area":
        data = json.loads(json.dumps(template_json or {}))
        for page in data.get("pages") or []:
            if not isinstance(page, dict):
                continue
            clean = []
            for obj in page.get("objects") or []:
                if not isinstance(obj, dict):
                    continue
                if (
                    obj.get("backgroundAsset") is True
                    or obj.get("exactVisualMaster") is True
                    or str(obj.get("fieldType") or "") in {"product-base-asset", "customer-product-asset"}
                ):
                    continue
                src = str(obj.get("src") or obj.get("baseSrc") or "").lower().split("?", 1)[0]
                if str(obj.get("type") or "").lower() == "image" and src.endswith((".png", ".jpg", ".jpeg", ".webp", ".gif")):
                    continue
                clean.append(obj)
            page["objects"] = clean
            # The product image is the visual base; template paper/background must
            # not cover it in restricted print-area mode.
            page["background"] = "rgba(255,255,255,0)"
        template_json = data

    template_json = _ensure_apparel_product_base(template_json, product_options, product)

    # Render the page count from the actual selected master, not a static
    # one-page footer. This also makes the correct count visible before JS runs.
    editor_template_page_count = len((template_json or {}).get("pages") or [])
    if not editor_template_page_count:
        editor_template_page_count = len(product_options.get("print_surfaces") or []) or 1

    template_catalog = [
        {
            "id": t.id,
            "name": t.name,
            "preview_url": (
                f"{t.preview.url}?v={int(t.updated_at.timestamp()) if t.updated_at else 0}"
                if t.preview
                else ""
            ),
            "url": (f"{reverse('designer:editor', args=[product.id])}?template={t.id}"
                    + (f"&size={(t.json_data or {}).get('sizeKey')}" if (t.json_data or {}).get("sizeKey") else "")),
            "size_key": (t.json_data or {}).get("sizeKey", ""),
            # Lightweight editable-vector data lets the editor draw a real
            # thumbnail when a generated template has no uploaded preview PNG.
            "preview_width": (t.json_data or {}).get("document", {}).get("width", product.width),
            "preview_height": (t.json_data or {}).get("document", {}).get("height", product.height),
            "preview_objects": (((t.json_data or {}).get("pages") or [{}])[0].get("objects") or []),
            "preview_background": (((t.json_data or {}).get("pages") or [{}])[0].get("background") or "#FFFFFF"),
            "kind": "database",
        }
        for t in live_templates_for(product)
    ]
    # Coaster templates are shape-aware views of the SAME editable artwork.
    # Preserve the selected shape on every template URL so switching designs
    # never silently returns the product to square.
    if product.id == 415:
        for item in template_catalog:
            item["url"] += ("&" if "?" in item["url"] else "?") + f"shape={product_options.get('selected_shape') or 'square'}"

    response = render(request, "designer/editor.html", {
        "product": product,
        "template": template,
        "template_json": json.dumps(template_json),
        "template_image": template_image,
        "template_catalog_json": json.dumps(template_catalog),
        "product_options_json": json.dumps(product_options),
        "admin_print_surfaces_json": json.dumps(product_options.get("print_surfaces") or []),
        "editor_template_page_count": editor_template_page_count,
        "existing_design": existing_design,
        # Loaded templates must initialize the front-end in template mode.
        "mode": request.GET.get("mode") or ("template" if template is not None else "blank"),
        "pack_code": pack_code or "",
    })
    # V27: template editing must reflect the latest admin-published JSON immediately.
    if template is not None:
        response["Cache-Control"] = "no-store, no-cache, must-revalidate, max-age=0"
        response["Pragma"] = "no-cache"
        response["Expires"] = "0"
    return response



