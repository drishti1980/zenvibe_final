def invitation_template_preview(request, template_id):
    from html import escape
    template=get_object_or_404(DesignTemplate,id=template_id)
    data=template.json_data or {}
    pages=data.get("pages") or []
    page=pages[0] if pages else data
    objects=page.get("objects") or []
    size=data.get("size") or {}
    width=int(float(size.get("width") or 750))
    height=int(float(size.get("height") or 1050))
    bg=page.get("background") or data.get("background") or "#ffffff"

    def num(v,default=0):
        try:return float(v)
        except (TypeError,ValueError):return default
    def colour(v,default="none"):
        if v is None or str(v).lower() in ("none","transparent",""): return "none"
        return escape(str(v),quote=True)

    svg=[f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {width} {height}" width="{width}" height="{height}">',
         f'<rect width="100%" height="100%" fill="{colour(bg,"#fff")}"/>']

    for o in objects:
        if not isinstance(o,dict) or o.get("visible") is False: continue
        typ=str(o.get("type") or "").lower()
        x=num(o.get("left",o.get("x",0))); y=num(o.get("top",o.get("y",0)))
        opacity=max(0,min(1,num(o.get("opacity",1),1)))
        fill=colour(o.get("fill")); stroke=colour(o.get("stroke")); sw=max(0,num(o.get("strokeWidth",0)))
        style=f' opacity="{opacity}"'
        if stroke!="none": style+=f' stroke="{stroke}" stroke-width="{sw or 1}"'
        if typ=="rect":
            svg.append(f'<rect x="{x}" y="{y}" width="{num(o.get("width",o.get("w",100)),100)}" height="{num(o.get("height",o.get("h",100)),100)}" rx="{num(o.get("rx",0))}" ry="{num(o.get("ry",0))}" fill="{fill}"{style}/>')
        elif typ=="circle":
            r=num(o.get("radius",o.get("r",40)),40)
            svg.append(f'<circle cx="{x+r}" cy="{y+r}" r="{r}" fill="{fill}"{style}/>')
        elif typ=="ellipse":
            rx=num(o.get("rx",90),90); ry=num(o.get("ry",55),55)
            svg.append(f'<ellipse cx="{x+rx}" cy="{y+ry}" rx="{rx}" ry="{ry}" fill="{fill}"{style}/>')
        elif typ=="line":
            pts=o.get("points") or [0,0,100,0]
            if len(pts)>=4:
                svg.append(f'<line x1="{num(pts[0])}" y1="{num(pts[1])}" x2="{num(pts[2])}" y2="{num(pts[3])}" stroke="{stroke if stroke!="none" else colour(o.get("fill"),"#222")}" stroke-width="{sw or 2}" opacity="{opacity}"/>')
        elif typ=="path" and o.get("path"):
            d=escape(str(o.get("path")),quote=True)
            trans=f'translate({x} {y})'
            angle=num(o.get("angle",0))
            if angle: trans+=f' rotate({angle})'
            svg.append(f'<path d="{d}" transform="{trans}" fill="{fill}"{style}/>')
        elif typ in ("text","i-text","textbox"):
            text=escape(str(o.get("text") or ""))
            size_px=max(6,num(o.get("fontSize",32),32))
            family=escape(str(o.get("font") or o.get("fontFamily") or "Arial"),quote=True)
            weight=escape(str(o.get("fontWeight") or ("700" if o.get("bold") else "400")),quote=True)
            align=str(o.get("textAlign") or "left")
            anchor={"center":"middle","right":"end"}.get(align,"start")
            svg.append(f'<text x="{x}" y="{y+size_px}" fill="{fill if fill!="none" else "#222"}" font-family="{family}" font-size="{size_px}" font-weight="{weight}" text-anchor="{anchor}" opacity="{opacity}">{text}</text>')
        elif typ=="image" and o.get("src"):
            src=escape(str(o.get("src")),quote=True)
            svg.append(f'<image href="{src}" x="{x}" y="{y}" width="{num(o.get("width",180),180)}" height="{num(o.get("height",120),120)}" preserveAspectRatio="xMidYMid meet" opacity="{opacity}"/>')

    svg.append("</svg>")
    response=HttpResponse(chr(10).join(svg),content_type="image/svg+xml")
    response["Cache-Control"]="no-store, max-age=0"
    return response


def editable_template_preview(request, template_id):
    template = get_object_or_404(
        DesignTemplate,
        pk=template_id,
        is_active=True
    )

    # Existing uploaded preview always wins
    if getattr(template, "preview", None):
        try:
            with template.preview.open("rb") as f:
                return HttpResponse(
                    f.read(),
                    content_type="image/png"
                )
        except Exception:
            pass

    # Find JSON field
    data = None

    for field_name in (
        "template_json",
        "design_json",
        "json_data",
    ):
        if hasattr(template, field_name):
            data = getattr(template, field_name)
            if data:
                break

    if isinstance(data, str):
        try:
            data = json.loads(data)
        except Exception:
            data = {}

    data = data or {}

    pages = data.get("pages") or []
    page = pages[0] if pages else {}

    objects = page.get("objects") or []

    # Thumbnail
    thumb_w = 300
    thumb_h = 420

    document = data.get("document") or {}

    source_w = float(document.get("width") or 750)
    source_h = float(document.get("height") or 1050)

    sx = thumb_w / source_w
    sy = thumb_h / source_h

    bg = page.get("background") or "#ffffff"

    try:
        image = Image.new(
            "RGB",
            (thumb_w, thumb_h),
            bg
        )
    except Exception:
        image = Image.new(
            "RGB",
            (thumb_w, thumb_h),
            "#ffffff"
        )

    draw = ImageDraw.Draw(image)

    def colour(value, default="#111111"):
        if not value:
            return default

        # Don't attempt CSS rgba in PIL
        if str(value).startswith("rgba"):
            return default

        return value

    for obj in objects:

        obj_type = obj.get("type")

        left = float(
            obj.get("left", obj.get("x", 0)) or 0
        ) * sx

        top = float(
            obj.get("top", obj.get("y", 0)) or 0
        ) * sy

        # RECTANGLE
        if obj_type == "rect":

            width = float(
                obj.get("width", obj.get("w", 0)) or 0
            ) * sx

            height = float(
                obj.get("height", obj.get("h", 0)) or 0
            ) * sy

            fill = obj.get("fill")

            if fill and not str(fill).startswith("rgba"):
                try:
                    draw.rectangle(
                        [
                            left,
                            top,
                            left + width,
                            top + height
                        ],
                        fill=fill
                    )
                except Exception:
                    pass

            stroke = obj.get("stroke")

            if stroke:
                try:
                    draw.rectangle(
                        [
                            left,
                            top,
                            left + width,
                            top + height
                        ],
                        outline=stroke,
                        width=max(
                            1,
                            int(
                                float(
                                    obj.get(
                                        "strokeWidth",
                                        1
                                    )
                                ) * sx
                            )
                        )
                    )
                except Exception:
                    pass

        # LINE
        elif obj_type == "line":

            points = obj.get("points") or []

            if len(points) >= 4:
                try:
                    draw.line(
                        [
                            float(points[0]) * sx,
                            float(points[1]) * sy,
                            float(points[2]) * sx,
                            float(points[3]) * sy,
                        ],
                        fill=colour(
                            obj.get("stroke")
                        ),
                        width=max(
                            1,
                            int(
                                float(
                                    obj.get(
                                        "strokeWidth",
                                        1
                                    )
                                ) * sx
                            )
                        )
                    )
                except Exception:
                    pass

        # CIRCLE
        elif obj_type == "circle":

            radius = float(
                obj.get("radius", 0) or 0
            )

            try:
                draw.ellipse(
                    [
                        left,
                        top,
                        left + radius * 2 * sx,
                        top + radius * 2 * sy,
                    ],
                    fill=colour(
                        obj.get("fill"),
                        "#eeeeee"
                    )
                )
            except Exception:
                pass

        # EDITABLE TEXT
        elif obj_type in (
            "text",
            "i-text",
            "textbox",
        ):

            value = str(
                obj.get("text") or ""
            )

            font_size = max(
                8,
                int(
                    float(
                        obj.get(
                            "fontSize",
                            24
                        )
                    ) * sy
                )
            )

            try:
                font = ImageFont.truetype(
                    "arial.ttf",
                    font_size
                )
            except Exception:
                font = ImageFont.load_default()

            fill = colour(
                obj.get("fill"),
                "#111111"
            )

            width = float(
                obj.get("width", 600) or 600
            ) * sx

            align = obj.get(
                "textAlign",
                "left"
            )

            lines = value.split("\n")

            y = top

            for line_text in lines:

                try:
                    bbox = draw.textbbox(
                        (0, 0),
                        line_text,
                        font=font
                    )

                    tw = bbox[2] - bbox[0]
                except Exception:
                    tw = 0

                x = left

                if align == "center":
                    x = left + (
                        width - tw
                    ) / 2

                elif align == "right":
                    x = left + width - tw

                try:
                    draw.text(
                        (x, y),
                        line_text,
                        font=font,
                        fill=fill
                    )
                except Exception:
                    pass

                y += font_size * 1.25

    buffer = io.BytesIO()

    image.save(
        buffer,
        format="PNG",
        optimize=True
    )

    buffer.seek(0)

    response = HttpResponse(
        buffer.getvalue(),
        content_type="image/png"
    )

    response["Cache-Control"] = (
        "public, max-age=3600"
    )

    return response

def _is_awards_product(product):
    """Identify awards by category ancestry, not a product-name guess."""
    category = getattr(product, "category", None)
    for _ in range(5):
        if category is None:
            break
        slug = str(getattr(category, "slug", "") or "").lower()
        name = str(getattr(category, "name", "") or "").lower()
        if slug in {"awards", "awards-trophies", "awards-and-trophies"} or name in {"awards", "awards & trophies", "awards and trophies"}:
            return True
        category = getattr(category, "parent", None)
    return False

def _is_apparel_product(product):
    category=getattr(product,"category",None); parent=getattr(category,"parent",None) if category else None
    hay=" ".join([str(getattr(product,"name","") or ""),str(getattr(category,"name","") or ""),str(getattr(parent,"name","") or "")]).lower()
    return any(x in hay for x in ("apparel","t-shirt","tshirt","shirt","polo","hoodie","jacket","jersey","sportswear","cap","hat"))

def _variant_image_url(product,color_name="",color_key=""):
    wanted={str(color_name or "").strip().lower(),str(color_key or "").replace("-"," ").strip().lower()}; wanted.discard("")
    for image in product.angle_images.all():
        if not image.image: continue
        label=str(image.label or "").strip().lower()
        if label and any(v==label or v in label or label in v for v in wanted):
            return image.image.url
    for image in product.angle_images.all():
        if not image.image: continue
        name=str(getattr(image.image,"name","") or "").lower().replace("-"," ")
        if any(v and v in name for v in wanted): return image.image.url
    return product.image.url if product.image else ""


