def update_cart(request, product_id):
    if request.method != "POST":
        return redirect("designer:cart")

    product = get_object_or_404(Product, id=product_id, is_active=True)
    cart = _store_cart(request)

    posted_key = (request.POST.get("cart_key") or "").strip()
    requested_size = (request.POST.get("size_key") or "").strip()
    requested_color = (request.POST.get("color_key") or "").strip()

    if posted_key and posted_key in cart and posted_key.split(":", 1)[0] == str(product_id):
        key = posted_key
    elif requested_size or requested_color:
        key = f"{product_id}:{requested_size}:{requested_color}"
    else:
        key = next(
            (str(k) for k in cart if str(k).split(":", 1)[0] == str(product_id)),
            str(product_id),
        )

    key_parts = str(key).split(":", 2)
    key_size = key_parts[1] if len(key_parts) > 1 else requested_size
    minimum = _effective_minimum_quantity(product, key_size)
    maximum = int(product.maximum_quantity or 9999)
    maximum = max(minimum, min(9999, maximum))

    try:
        qty = int((request.POST.get("quantity") or "").strip())
    except (TypeError, ValueError):
        qty = minimum

    qty = max(minimum, min(maximum, qty))
    cart[key] = qty
    _save_store_cart(request, cart)

    items, subtotal = _cart_payload(request)
    count = sum(i["quantity"] for i in items)
    line = next((i for i in items if i.get("cart_key") == str(key)), None)

    if request.headers.get("x-requested-with") == "XMLHttpRequest":
        return JsonResponse({
            "ok": True,
            "count": count,
            "subtotal": f"{subtotal:.2f}",
            "quantity": line["quantity"] if line else qty,
            "unit_price": f"{line['unit_price']:.2f}" if line else "0.00",
            "line_total": f"{line['line_total']:.2f}" if line else "0.00",
        })

    return redirect("designer:cart")

def remove_from_cart(request, product_id):
    if request.method != "POST":
        return redirect("designer:cart")

    cart = _store_cart(request)
    posted_key = (request.POST.get("cart_key") or "").strip()
    requested_size = (request.POST.get("size_key") or "").strip()
    requested_color = (request.POST.get("color_key") or "").strip()

    removed = False

    if posted_key and posted_key in cart and posted_key.split(":", 1)[0] == str(product_id):
        cart.pop(posted_key, None)
        removed = True
    elif requested_size or requested_color:
        key = f"{product_id}:{requested_size}:{requested_color}"
        if key in cart:
            cart.pop(key, None)
            removed = True
    else:
        # No variant was supplied: remove the matching product line(s).
        for key in list(cart.keys()):
            if str(key).split(":", 1)[0] == str(product_id):
                cart.pop(key, None)
                removed = True

    _save_store_cart(request, cart)

    if request.headers.get("x-requested-with") == "XMLHttpRequest":
        items, subtotal = _cart_payload(request)
        return JsonResponse({
            "ok": True,
            "removed": removed,
            "count": sum(i["quantity"] for i in items),
            "subtotal": f"{subtotal:.2f}",
            "empty": len(items) == 0,
        })

    return redirect("designer:cart")

def _create_stripe_cart_session(request, orders):
    import stripe
    from django.conf import settings
    from .models import OrderWorkflowConfig
    stripe.api_key = settings.STRIPE_SECRET_KEY or SiteSettings.current().stripe_secret_key
    cfg = OrderWorkflowConfig.current()
    order_numbers = [o.order_number for o in orders]
    line_items = []
    for order in orders:
        line_items.append({"quantity": 1, "price_data": {
            "currency": cfg.currency.lower(),
            "unit_amount": int(order.total * 100),
            "product_data": {"name": order.design.product.name if order.design and order.design.product else "ZenVibe product"},
        }})
    success_url = request.build_absolute_uri(reverse("designer:cart_order_success")) + "?session_id={CHECKOUT_SESSION_ID}"
    cancel_url = request.build_absolute_uri(reverse("designer:cart_checkout")) + "?payment=cancelled"
    session = stripe.checkout.Session.create(
        mode="payment",
        client_reference_id=order_numbers[0],
        customer_email=orders[0].customer_email,
        metadata={"order_numbers": ",".join(order_numbers)},
        line_items=line_items,
        success_url=success_url,
        cancel_url=cancel_url,
    )
    for order in orders:
        order.stripe_checkout_session_id = session.id
        order.payment_provider = "stripe"
        order.save(update_fields=["stripe_checkout_session_id", "payment_provider", "updated_at"])
    return session.url


def _canadian_checkout_error(request):
    from .customer_models import CustomerAddress
    province = request.POST.get("province", "").strip().upper()
    postal = re.sub(r"[ -]", "", request.POST.get("postal_code", "").upper())
    if province not in dict(CustomerAddress.PROVINCES):
        return "Select a valid Canadian province or territory."
    if not re.fullmatch(r"[ABCEGHJ-NPRSTVXY][0-9][ABCEGHJ-NPRSTV-Z][0-9][ABCEGHJ-NPRSTV-Z][0-9]", postal):
        return "Enter a valid Canadian postal code (e.g. M5V 3L9)."
    return None

def _customer_checkout_context(request):
    from .customer_models import CustomerAddress
    addresses = list(CustomerAddress.objects.filter(user=request.user)) if request.user.is_authenticated else []
    default_address = next((a for a in addresses if a.is_default), addresses[0] if addresses else None)
    user = request.user if request.user.is_authenticated else None
    # POST always wins: never replace a customer's submitted edits after validation.
    def checkout_value(field, saved=""):
        if request.method == "POST":
            return request.POST.get(field, "")
        return saved or ""
    full_name = (user.get_full_name().strip() or user.username) if user else ""
    return {
        "saved_addresses": addresses, "default_address": default_address,
        "canadian_provinces": CustomerAddress.PROVINCES,
        "checkout_initial": {
            "customer_name": checkout_value("customer_name", default_address.full_name if default_address else full_name),
            "customer_email": checkout_value("customer_email", user.email if user else ""),
            "customer_phone": checkout_value("customer_phone", default_address.phone if default_address else ""),
            "company": checkout_value("company", default_address.company if default_address else ""),
            "address": checkout_value("address", default_address.address if default_address else ""),
            "city": checkout_value("city", default_address.city if default_address else ""),
            "province": checkout_value("province", default_address.province if default_address else ""),
            "postal_code": checkout_value("postal_code", default_address.postal_code if default_address else ""),
        },
    }

def _save_checkout_address(request):
    if not request.user.is_authenticated or not request.POST.get("save_address"):
        return
    from .customer_views import AddressForm
    from .customer_models import CustomerAddress
    data = request.POST.copy()
    data["full_name"] = request.POST.get("customer_name", "")
    data["phone"] = request.POST.get("customer_phone", "")
    data["label"] = request.POST.get("address_label", "Home") or "Home"
