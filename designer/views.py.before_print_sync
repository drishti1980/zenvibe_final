def save_design(request):
    if request.method != "POST":
        return HttpResponseBadRequest("POST required")
    try:
        payload = json.loads(request.body.decode("utf-8"))
        product = Product.objects.get(id=payload.get("product_id"))
        design_id = payload.get("design_id")
        autosave = bool(payload.get("autosave"))
        design = None

        if design_id:
            # V33: stale browser/localStorage design ids must never break autosave.
            # A template can be opened for a different product/session after an old
            # SavedDesign was deleted. In that case simply create a fresh personal
            # design and return its new id to the browser.
            candidate = SavedDesign.objects.filter(id=design_id, product=product).first()
            if candidate is not None and _can_access(request, candidate):
                design = candidate

        source_template = None
        source_template_id = payload.get("source_template_id")
        if source_template_id:
            candidate_template = (
                DesignTemplate.objects
                .select_related("product", "product__category")
                .filter(id=source_template_id, is_active=True)
                .first()
            )
            if candidate_template and _template_allowed_for_product(candidate_template, product):
                source_template = candidate_template

        if design is None:
            # A customer's first save always creates a separate SavedDesign.
            # It never writes to DesignTemplate, even when opened from a master template.
            design = SavedDesign(
                product=product,
                source_template=source_template,
                **_owner_kwargs(request),
            )

        changed = design.design_json != (payload.get("design_json") or {})
        design.name = payload.get("name") or f"{product.name} Design"
        design.design_json = payload.get("design_json") or {}
        design.preview_png = payload.get("preview_png") or design.preview_png
        requested_qty = max(1, int(payload.get("quantity") or 1))
        selected_size_key = str(payload.get("size_key") or (payload.get("design_json") or {}).get("sizeProfile", {}).get("sizeKey") or "")[:100]
        selected_color_key = str(payload.get("color_key") or (payload.get("design_json") or {}).get("productColor") or "")[:100]
        _set_design_storefront_options(design, selected_size_key, selected_color_key)
        minimum = _effective_minimum_quantity(product, selected_size_key)
        design.quantity = max(minimum, requested_qty)
        design.is_autosave = autosave
        design.status = "draft" if autosave else payload.get("status", "cart")
        if design.pk and changed:
            design.version += 1
        design.save()

        if changed:
            DesignVersion.objects.get_or_create(
                design=design,
                version=design.version,
                defaults={"design_json": design.design_json, "preview_png": design.preview_png},
            )

        if design.status == "cart" and not autosave:
            size_key = _design_selected_size_key(design)
            color_key = _design_selected_color_key(design)
            key = f"{product.id}:{size_key}:{color_key}" if (size_key or color_key) else str(product.id)

            cart = _store_cart(request)
            cart[key] = max(1, min(9999, int(design.quantity or 1)))
            _save_store_cart(request, cart)

            design_map = _cart_design_map(request)
            design_map[key] = design.id
            _save_cart_design_map(request, design_map)

        return JsonResponse({
            "ok": True,
            "design_id": design.id,
            "version": design.version,
            "updated_at": design.updated_at.isoformat(),
            "cart_url": reverse("designer:cart"),
        })
    except Exception as exc:
        # Keep the JSON error visible to the editor; server logs now show the real cause too.
        import logging
        logging.getLogger(__name__).exception("save_design failed")
        return JsonResponse({"ok": False, "error": str(exc)}, status=400)


