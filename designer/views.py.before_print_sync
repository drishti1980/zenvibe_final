def _load_business_card_pack(code):
    """Convert one bundled card JSON into the editor's native layered page format."""
    code = str(code or "").upper().strip()
    if not re.fullmatch(r"BC\d{3}", code):
        return None
    path = Path(settings.BASE_DIR) / "designer" / "static" / "designer" / "business_card_templates" / "templates" / f"{code}.json"
    try:
        source = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return None

    def convert(el):
        typ = el.get("type")
        common = {
            "id": f"{code}-{el.get('role') or typ}-{abs(hash(json.dumps(el, sort_keys=True))) % 1000000}",
            "name": (el.get("role") or typ or "Layer").replace("_", " ").title(),
            "type": typ,
            "left": el.get("x", 0), "top": el.get("y", 0),
            "opacity": el.get("opacity", 1), "angle": el.get("angle", 0), "customerEditable": el.get("editable", True),
        }
        if typ == "text":
            common.update({"text": el.get("text", "Text"), "fontSize": el.get("fontSize", 32),
                           "font": el.get("fontFamily", "Arial"), "fontWeight": el.get("fontWeight", 400),
                           "fill": el.get("color", "#111827"), "textAlign": el.get("align", "left")})
            if el.get("width"): common["width"] = el["width"]
        elif typ == "rect":
            common.update({"width": el.get("width", 100), "height": el.get("height", 100),
                           "fill": el.get("fill", "#ffffff"), "rx": el.get("radius", 0), "ry": el.get("radius", 0)})
        elif typ == "circle":
            common.update({"radius": el.get("radius", 50), "fill": el.get("fill", "#111827")})
        elif typ == "line":
            common.update({"left": 0, "top": 0,
                           "points": [el.get("x1", 0), el.get("y1", 0), el.get("x2", 100), el.get("y2", 0)],
                           "stroke": el.get("stroke", "#111827"), "strokeWidth": el.get("strokeWidth", 2), "fill": None})
        elif typ == "image":
            # Keep the supplied logo slot editable without a broken placeholder image.
            if str(el.get("src", "")).startswith("placeholder://"):
                return {"id": common["id"], "name": "Logo - upload/replace", "type": "rect",
                        "left": el.get("x", 0), "top": el.get("y", 0), "width": el.get("width", 180),
                        "height": el.get("height", 120), "fill": "#f8fafc", "stroke": "#94a3b8",
                        "strokeWidth": 2, "customerEditable": True, "opacity": 1}
            common.update({"src": el.get("src"), "width": el.get("width", 180), "height": el.get("height", 120)})
        return common

    pages=[]
    for side_name in ("front", "back"):
        side=(source.get("sides") or {}).get(side_name) or {}
        objects=[convert(x) for x in side.get("elements", [])]
        objects=[x for x in objects if x]
        pages.append({"name": side_name.title(), "background": "#ffffff", "objects": objects})
    return {"version": 2, "pack_id": code, "name": source.get("name", code), "pages": pages}


