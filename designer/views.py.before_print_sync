def chatbot_message(request):
    if request.method != "POST":
        return JsonResponse({"ok": False, "error": "POST required"}, status=405)
    try:
        payload = json.loads(request.body.decode("utf-8") or "{}")
    except Exception:
        payload = request.POST.dict()
    message = (payload.get("message") or "").strip()[:1000]
    email = (payload.get("email") or "").strip()[:254]
    if not message:
        return JsonResponse({"ok": False, "reply": "Please type a question."}, status=400)

    lowered = message.lower()
    order_match = re.search(r"\bZV-[A-Z0-9]{6,12}\b", message.upper())
    if order_match:
        order = Order.objects.filter(order_number=order_match.group(0)).first()
        if order:
            allowed = request.user.is_authenticated and (request.user.is_staff or order.user_id == request.user.id)
            if not allowed and email and email.lower() == order.customer_email.lower():
                allowed = True
            if allowed:
                return JsonResponse({"ok": True, "reply": f"Order {order.order_number} is currently {order.get_status_display()}. Payment: {order.get_payment_status_display()}."})
            return JsonResponse({"ok": True, "needs_email": True, "reply": "I found that order. For privacy, enter the email used for the order and send the order number again."})
        email = _site_contact_email()
        return JsonResponse({"ok": True, "reply": f"I couldn't find that ZenVibe order number. Please check it or contact {email}."})

    words = set(re.findall(r"[a-z0-9]+", lowered))
    best = None
    best_score = 0
    for item in ChatbotKnowledge.objects.filter(is_active=True):
        hay = f"{item.question} {item.keywords} {item.category}".lower()
        terms = set(re.findall(r"[a-z0-9]+", hay))
        score = len(words & terms)
        if item.question.lower() in lowered or lowered in item.question.lower():
            score += 4
        if score > best_score:
            best, best_score = item, score
    if best and best_score >= 1:
        return JsonResponse({"ok": True, "reply": best.answer, "category": best.category})

    return JsonResponse({"ok": True, "fallback": True, "reply": "I can help with products, customization, proofs, bulk pricing, shipping, order status and contact details. If you want, leave your details and the ZenVibe team can follow up."})


