def _effective_minimum_quantity(product, size_key=""):
    """Minimum order quantity, independent of quantity-based price breaks.

    Product.minimum_quantity is the authoritative purchase minimum. A price
    tier's min_quantity is only the threshold for its unit price, not a
    mandatory order quantity. The size key is retained for caller compatibility.
    """
    try:
        return max(1, int(product.minimum_quantity or 1))
    except (TypeError, ValueError):
        return 1


def _product_unit_price(product, quantity, size_key=""):
    """Resolve the authoritative ONE-UNIT price for a cart quantity/size.

    Priority:
      1. Selected/default size variant quantity tier.
      2. Product-wide quantity tier.
      3. Selected/default size variant price.
      4. Product sale/base price.

    Line totals are always unit price * quantity.
    """
    from decimal import Decimal

    try:
        qty = max(1, int(quantity or 1))
    except (TypeError, ValueError):
        qty = 1

    tiers = product.price_tiers.filter(is_active=True)

    if size_key:
        variant = product.size_variants.filter(
            size_key=size_key, is_active=True
        ).first()
    else:
        # ProductSizeVariant has no is_default database field.
        # The first active variant by configured sort order is the storefront default.
        variant = (
            product.size_variants
            .filter(is_active=True)
            .order_by("sort_order", "id")
            .first()
        )

    eligible = None
    if variant is not None:
        eligible = (
            tiers.filter(variant=variant, min_quantity__lte=qty)
            .order_by("-min_quantity", "-id")
            .first()
        )

    if eligible is None:
        eligible = (
            tiers.filter(variant__isnull=True, min_quantity__lte=qty)
            .order_by("-min_quantity", "-id")
            .first()
        )

    if eligible is not None:
        return Decimal(str(eligible.unit_price)).quantize(Decimal("0.01"))

    if variant is not None and variant.price is not None:
        return Decimal(str(variant.price)).quantize(Decimal("0.01"))

    if product.is_on_sale and product.sale_price is not None:
        return Decimal(str(product.sale_price)).quantize(Decimal("0.01"))

    return Decimal(str(product.price or 0)).quantize(Decimal("0.01"))

def _editor_product_options(product,request,existing_design=None):
    admin_mode = getattr(product, "editor_layout_mode", "legacy") or "legacy"
    # Apparel always uses the product-first editor with a locked garment image.
    # Print-area coordinates and physical dimensions still come from Admin.
    if (_is_apparel_product(product) or _is_awards_product(product)) and admin_mode == "legacy":
        admin_mode = "print_area"
    admin_enabled = admin_mode != "legacy"
    workspace_width = float(product.workspace_width_in) if getattr(product, "workspace_width_in", None) is not None else None
    workspace_height = float(product.workspace_height_in) if getattr(product, "workspace_height_in", None) is not None else None

    sizes=[]
    for index,item in enumerate(product.size_variants.filter(is_active=True).order_by("sort_order","name","id")):
        profile={"sizeKey":item.size_key,"editorProfile":item.editor_profile or ""}
        # Backward compatibility: old products keep their existing ruler behaviour.
        # New Admin-driven products never overload PRINT dimensions as WORKSPACE dimensions.
        if not admin_enabled:
            if item.print_width_in is not None: profile["physicalWidth"]=float(item.print_width_in)
            if item.print_height_in is not None: profile["physicalHeight"]=float(item.print_height_in)
        if item.canvas_width: profile["documentWidth"]=item.canvas_width
        if item.canvas_height: profile["documentHeight"]=item.canvas_height
        sizes.append({
            "key":item.size_key,"name":item.name,"price":"",
            "minimum_quantity":product.minimum_quantity,
            "is_default":index==0,
            "editor_profile":profile,
        })

    colors=[]
    cm=getattr(product,"color_variants",None)
    if cm is not None:
        for index,item in enumerate(cm.filter(is_active=True).order_by("sort_order","name","id")):
            colors.append({
                "key":item.color_key,"name":item.name,"hex":item.hex_value or "",
                "is_default":index==0,
                "image_url":_variant_image_url(product,item.name,item.color_key),
            })

    ss=(request.GET.get("size") or request.GET.get("size_key") or "").strip()
    sc=(request.GET.get("color") or request.GET.get("color_key") or "").strip()
    if existing_design:
        ss=ss or _design_selected_size_key(existing_design)
        sc=sc or _design_selected_color_key(existing_design)
    if not ss and sizes: ss=sizes[0]["key"]
    if not sc and colors: sc=colors[0]["key"]
    row=next((x for x in colors if x["key"]==sc),None)

    # Coaster shape is a product variant, not a second template library.
    # The same template ID/JSON is used for Square and Circle; only the locked
    # non-printing product reference changes.
    selected_shape=(request.GET.get("shape") or request.GET.get("option_shape") or "square").strip().lower()
    if selected_shape not in {"square","circle"}:
        selected_shape="square"
    coaster_shape_url=""
    if (product.name or "").strip().lower()=="custom 3d printed coasters with logo":
        coaster_shape_url=static(
            "designer/product_refs/coaster-circle.svg"
            if selected_shape=="circle" else "designer/product_refs/coaster-square.svg"
        )

    print_surfaces=[]
    surface_manager=getattr(product,"print_surfaces",None)
    if surface_manager is not None:
        for surface in surface_manager.filter(is_active=True).order_by("sort_order","id"):
            sw = float(surface.workspace_width_in) if admin_enabled and surface.workspace_width_in is not None else workspace_width
            sh = float(surface.workspace_height_in) if admin_enabled and surface.workspace_height_in is not None else workspace_height
            print_surfaces.append({
                "id":surface.id,
                "key":getattr(surface,"key","") or "",
                "label":surface.label,
                # Existing editor reads printWidth/printHeight for its ruler.
                # For opted-in products only, feed it the explicit WORKSPACE dimensions.
                "printWidth": sw if admin_enabled and sw else float(surface.print_width_in),
                "printHeight": sh if admin_enabled and sh else float(surface.print_height_in),
                "workspaceWidth":sw,
                "workspaceHeight":sh,
                "physicalPrintWidth":float(surface.print_width_in),
                "physicalPrintHeight":float(surface.print_height_in),
                "unit":"in",
                "sortOrder":surface.sort_order,
            })

    print_areas=[]
    area_manager=getattr(product,"print_areas",None)
    if area_manager is not None:
        for area in area_manager.select_related("surface","product_image").order_by("sort_order","id"):
            print_areas.append({
                "id":area.id,
                "name":area.name,
                "surfaceId":area.surface_id,
                "productImageId":area.product_image_id,
                "leftPct":float(area.left),
                "topPct":float(area.top),
                "widthPct":float(area.width),
                "heightPct":float(area.height),
                "printWidth":float(area.print_width_in) if area.print_width_in is not None else None,
                "printHeight":float(area.print_height_in) if area.print_height_in is not None else None,
                "sortOrder":area.sort_order,
            })

    # The Admin "Default editable print area" is authoritative when no
    # per-surface/per-image ProductPrintArea record overrides it. Previously
    # printAreas was empty and the customer editor never received these values.
    if not print_areas:
        print_areas.append({
            "id":None, "name":"Default print area",
            "surfaceId":None, "productImageId":None,
            "leftPct":float(product.print_left_pct if product.print_left_pct is not None else 0),
            "topPct":float(product.print_top_pct if product.print_top_pct is not None else 0),
            "widthPct":float(product.print_width_pct if product.print_width_pct is not None else 100),
            "heightPct":float(product.print_height_pct if product.print_height_pct is not None else 100),
            "printWidth":float(product.print_width_in) if product.print_width_in is not None else None,
            "printHeight":float(product.print_height_in) if product.print_height_in is not None else None,
            "sortOrder":0,
        })

    # Locked reference views are separate from customer artwork. Promotional
    # products may expose Front/Back together on ONE editor page, matching the
    # source catalogue presentation. ProductImage rows remain non-printing.
    reference_images=[]
    seen_reference_urls=set()
    def _add_reference(url,label="",image_id=None):
        if not url or url in seen_reference_urls:
            return
        seen_reference_urls.add(url)
        reference_images.append({"url":url,"label":label or "Product","productImageId":image_id})
    if coaster_shape_url:
        _add_reference(coaster_shape_url, selected_shape.title())
    elif product.editor_reference_image:
        _add_reference(product.editor_reference_image.url,"Front")
    elif product.image:
        _add_reference(product.image.url,"Front")
    angle_qs=product.angle_images.all().order_by("sort_order","id")
    for angle in angle_qs:
        if angle.image:
            _add_reference(angle.image.url,angle.label or f"View {len(reference_images)+1}",angle.id)

    editor_config={
        "enabled":admin_enabled,
        "mode":admin_mode,
        "workspaceWidth":workspace_width,
        "workspaceHeight":workspace_height,
        "unit":"in",
        "constrainToPrintArea":bool(getattr(product,"constrain_to_print_area",False)) or _is_apparel_product(product) or _is_awards_product(product),
        "showProductReference":bool(getattr(product,"show_product_reference",False)),
        "printAreas":print_areas,
        "referenceImages":reference_images,
        "referenceLayout":"single-page-front-back" if product.category and product.category.slug=="promotional-products" else "single",
    }

    return {
        "is_apparel":_is_apparel_product(product),"sizes":sizes,"colors":colors,
        "selected_size":ss,"selected_color":sc,"selected_shape":selected_shape,
        "minimum_quantity":product.minimum_quantity,
        "base_image_url":(
            # Storefront colour selection is authoritative for product-first editors.
            # A selected colour must reach Customize as the matching local ProductImage;
            # editor_reference_image is only the colourless/default fallback.
            (coaster_shape_url or (row or {}).get("image_url") or (
                product.editor_reference_image.url if product.editor_reference_image else _variant_image_url(product)
            ))
            if admin_enabled and admin_mode == "print_area"
            else ((row or {}).get("image_url") or _variant_image_url(product))
        ),
        "print_surfaces":print_surfaces,
        "printSurfaces":print_surfaces,
        "editor_config":editor_config,
        "editorConfig":editor_config,
    }

def _ensure_apparel_product_base(template_json,options,product):
    if not options.get("is_apparel"): return template_json or {}
    data=json.loads(json.dumps(template_json or {})); size=data.get("size") or {}
    W=int(size.get("width") or product.width or 900); H=int(size.get("height") or product.height or 900)
    pages=data.get("pages")
    if not isinstance(pages,list) or not pages: pages=[{"name":"Front","background":"#fff","objects":[]}]; data["pages"]=pages
    url=options.get("base_image_url") or ""
    for i,page in enumerate(pages):
        objs=[]
        for o in page.get("objects") or []:
            if not isinstance(o,dict): continue
            if str(o.get("fieldType") or "") in ("customer-product-asset","product-base-asset"): continue
            if str(o.get("name") or "").lower() in ("editable apparel product image","apparel product visual"): continue
            objs.append(o)
        if url:
            objs.insert(0,{"id":f"zv-product-base-{i+1}","type":"image","src":url,"baseSrc":url,"left":W/2,"top":H/2,
                "originX":"center","originY":"center","width":W,"height":H,"opacity":1,"backgroundAsset":True,
                "exactVisualMaster":True,"customerEditable":False,"locked":True,"name":"Product colour preview","fieldType":"product-base-asset"})
        page["objects"]=objs
    data["size"]={"width":W,"height":H}; data["selectedSizeKey"]=options.get("selected_size",""); data["selectedColorKey"]=options.get("selected_color","")
    return data

def _product_option_groups(product, size_variants, color_variants):
    """Normalize arbitrary source product attributes for the storefront.

    Size and Colour use their dedicated DB tables when present. Everything else
    (Material, Printed Sides, Printing Method, Decoration Technology, etc.) is
    read from Product.source_attributes, so different products can expose
    different controls without hard-coded category logic.
    """
    raw = getattr(product, "source_attributes", None) or {}
    groups = []
    if isinstance(raw, dict):
        items = raw.items()
    else:
        items = []
    skip = {"quantity", "qty", "price", "unit price"}
    if size_variants:
        skip.update({"size", "select size", "product size"})
    if color_variants:
        skip.update({"color", "colour", "product color", "product colour"})
    for label, values in items:
        label_text = str(label or "").strip()
        label_key = label_text.lower()
        # Internal import/provenance metadata belongs in the database only.
        # Never expose source URLs, source IDs or localisation flags as
        # customer-selectable product options on the storefront.
        if (
            not label_text
            or label_key in skip
            or label_key.startswith("source_")
            or label_key.startswith("catalogue_")
            or label_key in {"live_url", "source_localized"}
        ):
            continue
        if isinstance(values, str):
            values = [v.strip() for v in re.split(r"[,|]", values) if v.strip()]
        elif isinstance(values, (tuple, set)):
            values = list(values)
        if not isinstance(values, list):
            continue
        cleaned = []
        for value in values:
            text = str(value or "").strip()
            if text and text not in cleaned:
                cleaned.append(text)
        if cleaned:
            groups.append({"label": label_text, "key": re.sub(r"[^a-z0-9]+", "-", label_text.lower()).strip("-"), "values": cleaned})
    return groups


