def my_orders(request):
    from .models import Order
    from .services.order_workflow import sync_order_status

    if request.user.is_authenticated:
        orders = list(
            Order.objects.filter(user=request.user)
            .select_related("design", "design__product")
            .prefetch_related("status_history")
        )
    else:
        # A guest can reach My Orders only after verifying order number + phone
        # on the order-tracking page.
        tracked_id = request.session.get("tracked_order_id")
        orders = list(
            Order.objects.filter(pk=tracked_id)
            .select_related("design", "design__product")
            .prefetch_related("status_history")
        ) if tracked_id else []

    for o in orders:
        sync_order_status(o)
        o.refresh_from_db()

    current_statuses = {"new", "confirmed", "in_production", "shipped"}
    current_orders = [o for o in orders if o.status in current_statuses]
    order_history = [o for o in orders if o.status not in current_statuses]

    highlight = (request.GET.get("order") or "").strip()
    return render(request, "designer/my_orders.html", {
        "orders": orders,
        "current_orders": current_orders,
        "order_history": order_history,
        "highlight_order": highlight,
        "account_layout": "designer/account_shell.html" if request.user.is_authenticated else "designer/base.html",
    })


