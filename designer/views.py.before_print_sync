def asset_candidates(url):
    """Given any already-built static or media URL (e.g. '/zenvibe/media/products/x.webp'
    or '/zenvibe/static/designer/img/drinkware/y.png'), return a de-duplicated list of
    plausible alternate URLs for hosts that serve assets under a different path prefix
    than what STATIC_URL/MEDIA_URL declare in settings.py (common on cPanel/Passenger
    deployments -- see award_asset() below, which this generalises to every asset type
    used across the site: category photos, product photos, and customizer mockups).
    The front-end tries these in order and keeps whichever one actually loads."""
    if not url:
        return []
    candidates = [url]
    if url.startswith("/zenvibe/"):
        candidates.append(url[len("/zenvibe"):])          # strip the /zenvibe prefix
    else:
        candidates.append("/zenvibe" + url)                # or add it back
    candidates.append(url.lstrip("/"))                      # relative, last resort
    seen = set()
    result = []
    for c in candidates:
        if c and c not in seen:
            seen.add(c)
            result.append(c)
    return result

