@csrf_exempt
def stripe_webhook(request):
    from django.conf import settings
    from django.utils import timezone
    from .models import Order
    from .services.order_workflow import sync_order_status
    if request.method != "POST": return HttpResponse(status=405)
    try:
        import stripe
        payload = request.body
        sig = request.META.get("HTTP_STRIPE_SIGNATURE", "")
        site = SiteSettings.current()
        webhook_secret = getattr(settings, "STRIPE_WEBHOOK_SECRET", "") or site.stripe_webhook_secret
        event = stripe.Webhook.construct_event(payload, sig, webhook_secret)
    except Exception:
        return HttpResponse(status=400)
    if event.get("type") == "checkout.session.completed":
        session = event["data"]["object"]
        metadata = session.get("metadata") or {}
        order_number = session.get("client_reference_id") or metadata.get("order_number")
        order_numbers = [x.strip() for x in metadata.get("order_numbers", "").split(",") if x.strip()]
        if not order_numbers and order_number:
            order_numbers = [order_number]
        if order_numbers and session.get("payment_status") == "paid":
            for order in Order.objects.filter(order_number__in=order_numbers):
                order.payment_status = "paid"; order.payment_provider = "stripe"; order.paid_at = timezone.now(); order.stripe_checkout_session_id = session.get("id", "")
                order.save(update_fields=["payment_status","payment_provider","paid_at","stripe_checkout_session_id","updated_at"])
                sync_order_status(order)
    return HttpResponse(status=200)


@require_POST
def vectorize_upload(request):
    """Convert customer-uploaded raster artwork to SVG without touching product/UI images.

    PNG/JPEG/WebP uploads are traced with VTracer. SVG uploads are returned after
    lightweight XML sanitisation. The editor loads the returned SVG as Fabric vector
    objects so artwork can be moved, resized, recoloured, layered and ungrouped.
    """
    upload = request.FILES.get("file")
    if not upload:
        return JsonResponse({"ok": False, "error": "No artwork file supplied."}, status=400)
    if upload.size > 15 * 1024 * 1024:
        return JsonResponse({"ok": False, "error": "Artwork exceeds the 15 MB limit."}, status=400)
    raw = upload.read()
    content_type = (upload.content_type or "").lower()
    name = (upload.name or "artwork").lower()
    try:
        if content_type == "image/svg+xml" or name.endswith(".svg"):
            import xml.etree.ElementTree as ET
            root = ET.fromstring(raw.decode("utf-8", errors="strict"))
            # Remove script/foreignObject and inline event handlers/external hrefs.
            forbidden = {"script", "foreignObject"}
            for parent in list(root.iter()):
                for child in list(parent):
                    if child.tag.split("}")[-1] in forbidden:
                        parent.remove(child)
                for key in list(parent.attrib):
                    local = key.split("}")[-1].lower()
                    val = parent.attrib.get(key, "")
                    if local.startswith("on") or (local in {"href", "xlink:href"} and val.startswith(("http:", "https:", "javascript:"))):
                        del parent.attrib[key]
            svg = ET.tostring(root, encoding="unicode")
        else:
            if content_type and content_type not in {"image/png", "image/jpeg", "image/jpg", "image/webp", "image/bmp"}:
                return JsonResponse({"ok": False, "error": "Use PNG, JPG, WebP, BMP or SVG artwork."}, status=400)
            try:
                import vtracer
            except ImportError:
                return JsonResponse({"ok": False, "error": "VTracer is not installed. Run: python -m pip install -r requirements.txt"}, status=500)
            cfg = vtracer.Config.poster()
            cfg.hierarchical = "cutout"
            cfg.mode = "spline"
            cfg.max_colors = 32
            cfg.optimize = 2
            svg = cfg.convert_bytes(raw)
        return JsonResponse({"ok": True, "svg": svg, "name": upload.name})
    except Exception as exc:
        return JsonResponse({"ok": False, "error": "Could not vectorize this artwork: %s" % exc}, status=400)


@staff_member_required
@require_POST
def admin_image_text_ocr(request):
    """Server-side OCR for uploaded artwork; image bytes are not persisted."""
    import base64
    import io
    from PIL import Image
    from django.http import JsonResponse
    try:
        payload = json.loads(request.body)
        data = payload.get("image", "")
        if not data.startswith("data:image/") or "," not in data:
            return JsonResponse({"error": "Image data URL required"}, status=400)
        raw = base64.b64decode(data.split(",", 1)[1], validate=True)
        if len(raw) > 15 * 1024 * 1024:
            return JsonResponse({"error": "Image exceeds 15 MB"}, status=413)
        image = Image.open(io.BytesIO(raw))
        image.verify()
        image = Image.open(io.BytesIO(raw)).convert("RGB")
        if image.width * image.height > 24000000:
            return JsonResponse({"error": "Image dimensions too large"}, status=413)
        try:
            import easyocr
            import numpy as np
        except ImportError:
            return JsonResponse({"error": "Install easyocr and numpy on the server"}, status=503)
        if not hasattr(admin_image_text_ocr, "_reader"):
            admin_image_text_ocr._reader = easyocr.Reader(["en"], gpu=False)
        # Fast path: one bounded-resolution OCR pass. Retry with overlapping
        # crops only when the first pass finds no usable text.
        from PIL import ImageOps, ImageEnhance
        reader = admin_image_text_ocr._reader
        width, height = image.size
        lines = []

        def scan_region(box, enhanced=False):
            x0, y0, x1, y1 = box
            crop = image.crop(box)
            if enhanced:
                crop = ImageEnhance.Contrast(ImageOps.grayscale(crop).convert("RGB")).enhance(1.7)
            # Limit CPU work on high-resolution uploads; preserve source coordinates.
            longest = max(crop.size)
            scale = min(2.0, 1600.0 / longest) if longest else 1.0
            if abs(scale - 1.0) > .05:
                crop = crop.resize((max(1, round(crop.width * scale)),
                                    max(1, round(crop.height * scale))), Image.Resampling.LANCZOS)
            try:
                results = reader.readtext(np.asarray(crop), detail=1,
                                          paragraph=False, decoder="greedy", mag_ratio=1.0)
            except Exception:
                import logging
                logging.getLogger(__name__).exception("OCR region failed")
                return
            for quad, value, confidence in results:
                text = str(value).strip()
                if len(text) < 2 or float(confidence) < .25:
                    continue
                xs = [float(pt[0]) / scale + x0 for pt in quad]
                ys = [float(pt[1]) / scale + y0 for pt in quad]
                bbox = {"x0": max(0, min(xs)), "y0": max(0, min(ys)),
                        "x1": min(width, max(xs)), "y1": min(height, max(ys))}
                if bbox["x1"] > bbox["x0"] and bbox["y1"] > bbox["y0"]:
                    lines.append({"text": text, "confidence": round(float(confidence) * 100, 1),
                                  "bbox": bbox})

        scan_region((0, 0, width, height))
        if not lines and width >= 300 and height >= 160:
            # Fallback for tiny or low-contrast lettering, rather than running
            # ten OCR passes on every image regardless of results.
            scan_region((0, 0, width, height), enhanced=True)
            if not lines:
                scan_region((0, 0, int(width * .65), height))
                scan_region((int(width * .35), 0, width, height))
        # Prefer higher-confidence readings when tiled passes overlap.
        lines.sort(key=lambda item: item["confidence"], reverse=True)
        unique = []
        for item in lines:
            a = item["bbox"]
            duplicate = False
            for other in unique:
                b = other["bbox"]
                ix = max(0, min(a["x1"], b["x1"]) - max(a["x0"], b["x0"]))
                iy = max(0, min(a["y1"], b["y1"]) - max(a["y0"], b["y0"]))
                smaller = min((a["x1"]-a["x0"])*(a["y1"]-a["y0"]),
                              (b["x1"]-b["x0"])*(b["y1"]-b["y0"]))
                if smaller > 0 and ix*iy/smaller > .65:
                    duplicate = True
                    break
            if not duplicate:
                unique.append(item)
        lines = sorted(unique, key=lambda item: (item["bbox"]["y0"], item["bbox"]["x0"]))
        return JsonResponse({"lines": lines, "engine": "easyocr"})
    except Exception:
        import logging
        logging.getLogger(__name__).exception("Admin artwork OCR failed")
        return JsonResponse({"error": "OCR processing failed"}, status=500)

