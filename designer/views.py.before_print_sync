@staff_member_required
def save_print_area(request, product_id):
    if request.method != "POST":
        return HttpResponseBadRequest("POST required")
    product = get_object_or_404(Product, id=product_id)
    try:
        payload = json.loads(request.body.decode("utf-8"))
        left = float(payload.get("left")); top = float(payload.get("top"))
        width = float(payload.get("width")); height = float(payload.get("height"))
        image_id = payload.get("image_id")
    except (TypeError, ValueError, AttributeError):
        return JsonResponse({"ok": False, "error": "Invalid print area values."}, status=400)
    if not (0 <= left <= 100 and 0 <= top <= 100 and 1 <= width <= 100 and 1 <= height <= 100):
        return JsonResponse({"ok": False, "error": "Print area must stay within 0–100%."}, status=400)
    if left + width > 100.01 or top + height > 100.01:
        return JsonResponse({"ok": False, "error": "Print area extends beyond the product image."}, status=400)
    target = product
    if image_id not in (None, "", "main"):
        target = get_object_or_404(product.angle_images, id=int(image_id))
    fields = ["print_left_pct", "print_top_pct", "print_width_pct", "print_height_pct"]
    target.print_left_pct = left; target.print_top_pct = top
    target.print_width_pct = width; target.print_height_pct = height
    target.save(update_fields=fields)
    return JsonResponse({"ok": True, "message": "Print area saved for this image."})


def _build_photo_studio_context(request, product, fallback_image_asset="designer/img/bags/budget-cotton-tote.png"):
    """Shared engine behind every 'photo + editable area' customizer (Bags, and the
    generic photo customizer used for every other non-bespoke category). Builds a
    catalogue of every sibling product in the same category, each with its own
    uploaded photo and admin-defined (or default) percentage-based print area."""
    template_id = request.GET.get("template")
    design_id = request.GET.get("design")
    template = None
    template_json = {}
    template_image = ""
    existing_design = None
    if design_id:
        candidate = get_object_or_404(SavedDesign, id=design_id, product=product)
        if _can_access(request, candidate):
            existing_design = candidate
            template_json = json.loads(json.dumps(candidate.design_json or {}))
    elif template_id:
        template = _get_template_for_product(template_id, product)
        template_json = json.loads(json.dumps(template.json_data or {}))
        if template.preview:
            template_image = template.preview.url
    template_catalog = [{"id": t.id, "name": t.name, "size_key": (t.json_data or {}).get("sizeKey", ""), "preview": (t.preview.name if t.preview else None),
                          "cache_bust": (int(t.updated_at.timestamp()) if t.updated_at else 0)} for t in live_templates_for(product)]
    for item in template_catalog:
        preview_name = item.get("preview")
        base_url = DesignTemplate._meta.get_field("preview").storage.url(preview_name) if preview_name else ""
        item["preview_url"] = f"{base_url}?v={item['cache_bust']}" if base_url else ""
        item.pop("preview", None)
        item.pop("cache_bust", None)

    # Default editable-area box (percent of photo size) used when a product hasn't
    # had its print area set yet via the Print Area Designer. A centered, slightly
    # lower box is a reasonable starting point for most product photos.
    DEFAULT_AREA_PCT = {"left": 30.0, "top": 55.0, "width": 40.0, "height": 20.0}
    FALLBACK_IMAGE = static(fallback_image_asset)

    sibling_products = (
        Product.objects.filter(category=product.category, is_active=True, is_out_of_stock=False)
        .order_by("name")
    )

    catalogue = []
    for p in sibling_products:
        image_url = p.image.url if p.image else FALLBACK_IMAGE
        image_urls = asset_candidates(image_url)
        area_pct = {
            "left": float(p.print_left_pct) if p.print_left_pct is not None else DEFAULT_AREA_PCT["left"],
            "top": float(p.print_top_pct) if p.print_top_pct is not None else DEFAULT_AREA_PCT["top"],
            "width": float(p.print_width_pct) if p.print_width_pct is not None else DEFAULT_AREA_PCT["width"],
            "height": float(p.print_height_pct) if p.print_height_pct is not None else DEFAULT_AREA_PCT["height"],
        }
        views = [{
            "key": "main", "image_id": None, "label": "Main", "image_url": image_url,
            "image_urls": image_urls, "print_area_pct": area_pct,
            "has_custom_area": p.print_left_pct is not None,
        }]
        for idx, extra in enumerate(p.angle_images.all()):
            if not extra.image:
                continue
            extra_pct = {
                "left": float(extra.print_left_pct) if extra.print_left_pct is not None else area_pct["left"],
                "top": float(extra.print_top_pct) if extra.print_top_pct is not None else area_pct["top"],
                "width": float(extra.print_width_pct) if extra.print_width_pct is not None else area_pct["width"],
                "height": float(extra.print_height_pct) if extra.print_height_pct is not None else area_pct["height"],
            }
            extra_url = extra.image.url
            views.append({
                "key": f"image-{extra.id}", "image_id": extra.id,
                "label": extra.label or f"View {idx + 2}", "image_url": extra_url,
                "image_urls": asset_candidates(extra_url), "print_area_pct": extra_pct,
                "has_custom_area": extra.print_left_pct is not None,
            })
        editor_options = p.customizer_config or {}
        configured_sizes = {v.name: float(v.price if v.price is not None else p.price) for v in p.size_variants.filter(is_active=True)}
        catalogue.append({
            "key": p.slug, "name": p.name, "product_id": p.id,
            "image_url": image_url, "image_urls": image_urls, "views": views,
            "sizes": configured_sizes or editor_options.get("sizes") or {"Standard": float(p.price)},
            "colours": editor_options.get("colours") or ["#111111", "#ffffff", "#2563eb"],
            "methods": editor_options.get("methods") or ["front", "screen-print", "embroidery", "heat-transfer", "full-colour"],
            "preview": editor_options.get("preview") or {"max_width": 692, "max_height": 692},
            "print_area_pct": area_pct,
            "has_custom_area": p.print_left_pct is not None,
            "admin_area_url": f"/admin-print-area/{p.id}/",
        })

    selected_key = product.slug if any(c["key"] == product.slug for c in catalogue) else (catalogue[0]["key"] if catalogue else "")

    return {
        "product": product, "template": template, "template_json": json.dumps(template_json),
        "template_image": template_image, "template_catalog_json": json.dumps(template_catalog),
        "existing_design": existing_design, "mode": request.GET.get("mode", "blank"),
        "config_json": json.dumps({"catalogue": catalogue, "selected_key": selected_key}),
    }


