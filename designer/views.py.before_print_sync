CART_SESSION_KEY = "zenvibe_store_cart"
CART_DESIGN_MAP_KEY = "zenvibe_cart_design_map"


def _store_cart(request):
    cart = request.session.get(CART_SESSION_KEY, {})
    if not isinstance(cart, dict):
        cart = {}
    return cart


def _save_store_cart(request, cart):
    request.session[CART_SESSION_KEY] = cart
    request.session.modified = True


def _cart_design_map(request):
    mapping = request.session.get(CART_DESIGN_MAP_KEY, {})
    return mapping if isinstance(mapping, dict) else {}


def _save_cart_design_map(request, mapping):
    request.session[CART_DESIGN_MAP_KEY] = mapping
    request.session.modified = True


def _cart_payload(request):
    from decimal import Decimal
    cart = _store_cart(request)
    design_map = _cart_design_map(request)
    ids = []
    for key in cart.keys():
        try:
            ids.append(int(str(key).split(":", 1)[0]))
        except (TypeError, ValueError):
            pass
    products = {
        p.id: p for p in Product.objects.filter(
            id__in=ids, is_active=True, is_out_of_stock=False
        ).select_related("category")
    }
    items = []
    subtotal = Decimal("0.00")
    clean = {}
    for key, raw_qty in cart.items():
        try:
            parts = str(key).split(":", 2); pid = int(parts[0]); size_key = parts[1] if len(parts)>1 else ""; color_key = parts[2] if len(parts)>2 else ""
            qty = max(1, min(9999, int(raw_qty)))
        except (TypeError, ValueError):
            continue
        product = products.get(pid)
        if not product:
            continue
        variant = product.size_variants.filter(size_key=size_key, is_active=True).first() if size_key else None
        color_variant = product.color_variants.filter(color_key=color_key, is_active=True).first() if color_key else None
        minimum = _effective_minimum_quantity(product, size_key)
        maximum = int(product.maximum_quantity or 9999)
        maximum = max(minimum, min(9999, maximum))
        qty = max(minimum, min(maximum, qty))
        unit_price = _product_unit_price(product, qty, size_key)
        line_total = (unit_price * qty).quantize(Decimal("0.01"))
        subtotal = (subtotal + line_total).quantize(Decimal("0.01"))
        clean[str(key)] = qty
        design = None
        design_id = design_map.get(str(key))
        if design_id:
            candidate = SavedDesign.objects.filter(id=design_id, product=product).first()
            if candidate is not None and _can_access(request, candidate):
                design = candidate

        items.append({
            "product": product,
            "quantity": qty,
            "unit_price": unit_price,
            "line_total": line_total,
            "size_key": size_key,
            "color_key": color_key,
            "cart_key": str(key),
            "variant": variant,
            "color_variant": color_variant,
            "minimum_quantity": minimum,
            "maximum_quantity": maximum,
            "design": design,
        })
    if clean != cart:
        _save_store_cart(request, clean)
    return items, subtotal


def add_to_cart(request, product_id):
    product = get_object_or_404(Product, id=product_id, is_active=True, is_out_of_stock=False)
    cart = _store_cart(request)
    try:
        qty = int(request.POST.get("quantity", 1))
    except (TypeError, ValueError):
        qty = product.minimum_quantity or 1

    size_key = (request.POST.get("size_key") or request.GET.get("size") or "").strip()[:100]
    color_key = (request.POST.get("color_key") or request.GET.get("color") or "").strip()[:100]

    if size_key and not product.size_variants.filter(size_key=size_key, is_active=True).exists():
        size_key = ""
    if color_key and not product.color_variants.filter(color_key=color_key, is_active=True).exists():
        color_key = ""

    minimum = _effective_minimum_quantity(product, size_key)
    maximum = int(product.maximum_quantity or 9999)
    maximum = max(minimum, min(9999, maximum))
    qty = max(minimum, min(maximum, qty))

    key = f"{product.id}:{size_key}:{color_key}" if (size_key or color_key) else str(product.id)

    # The quantity entered on the product page is the requested cart quantity.
    # Example: if the customer enters 60, the cart must contain 60 — not the
    # previous quantity plus 60. This also makes repeated Add To Cart clicks idempotent.
    cart[key] = qty
    _save_store_cart(request, cart)

    count = sum(int(v) for v in cart.values())
    if request.headers.get("x-requested-with") == "XMLHttpRequest":
        return JsonResponse({
            "ok": True,
            "count": count,
            "product": product.name,
            "quantity": cart[key],
            "cart_url": reverse("designer:cart"),
        })
    if request.POST.get("cart_action") == "buy_now":
        return redirect("designer:cart_checkout")
    return redirect("designer:cart")


