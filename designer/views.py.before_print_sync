        if not existing.filter(address__iexact=address.address, city__iexact=address.city, postal_code=address.postal_code).exists():
            address.is_default = not existing.exists()
            address.save()

def _checkout_coupon(code, subtotal):
    from decimal import Decimal
    from django.utils import timezone
    from .models import DiscountCoupon
    coupon = DiscountCoupon.objects.filter(code=code.strip().upper().lstrip("#"), is_active=True).first()
    if not coupon:
        return None, Decimal("0.00"), "Invalid or inactive coupon code."
    now = timezone.now()
    if (coupon.starts_at and now < coupon.starts_at) or (coupon.expires_at and now >= coupon.expires_at):
        return None, Decimal("0.00"), "This coupon is not currently available."
    if subtotal < coupon.minimum_subtotal:
        return None, Decimal("0.00"), "Minimum order amount for this coupon has not been reached."
    discount = (subtotal * coupon.value / Decimal("100")) if coupon.discount_type == "percent" else coupon.value
    discount = min(subtotal, discount).quantize(Decimal("0.01"))
    return coupon, discount, ""


def cart_checkout(request):
    from .models import Order, OrderWorkflowConfig
    from .services.order_workflow import send_order_created_emails, sync_order_status
    items, subtotal = _cart_payload(request)
    if not items:
        return redirect("designer:cart")
    cfg = OrderWorkflowConfig.current()
    from .models import DiscountCoupon
    from decimal import Decimal
    from django.utils import timezone
    now = timezone.now()
    visible_coupons = DiscountCoupon.objects.filter(is_active=True, show_at_checkout=True).filter(
        Q(starts_at__isnull=True) | Q(starts_at__lte=now)
    ).filter(Q(expires_at__isnull=True) | Q(expires_at__gt=now))[:8]
    coupon_code = request.session.get("zv_checkout_coupon", "")
    coupon, discount, coupon_error = _checkout_coupon(coupon_code, subtotal) if coupon_code else (None, Decimal("0.00"), "")
    coupon_context = {"visible_coupons": visible_coupons, "applied_coupon": coupon, "discount": discount, "discounted_total": subtotal - discount, "coupon_error": coupon_error}
    if request.method == "POST" and request.POST.get("coupon_action"):
        entered = request.POST.get("coupon", "").strip()
        if request.POST.get("coupon_action") == "remove":
            request.session.pop("zv_checkout_coupon", None)
            return redirect("designer:cart_checkout")
        coupon, discount, coupon_error = _checkout_coupon(entered, subtotal)
        if coupon:
            request.session["zv_checkout_coupon"] = coupon.code
            return redirect("designer:cart_checkout")
        coupon_context.update({"coupon_error": coupon_error, "applied_coupon": None, "discount": Decimal("0.00"), "discounted_total": subtotal})
        return render(request, "designer/cart_checkout.html", {**_customer_checkout_context(request), **coupon_context, "items": items, "subtotal": subtotal, "payment_mode": cfg.payment_mode})
    if request.method == "POST":
        required = ["customer_name", "customer_email", "customer_phone", "company", "address", "city", "province", "postal_code"]
        missing = [x for x in required if not request.POST.get(x, "").strip()]
        if not missing:
            address_error = _canadian_checkout_error(request)
            if address_error:
                return render(request, "designer/cart_checkout.html", {**_customer_checkout_context(request), **coupon_context, "error": address_error, "items": items, "subtotal": subtotal, "payment_mode": cfg.payment_mode})
            _save_checkout_address(request)
            orders = []
            for item in items:
                product = item["product"]
                design = item.get("design")
                if design is not None:
                    design.quantity = item["quantity"]
                    _set_design_storefront_options(design, item.get("size_key", ""), item.get("color_key", ""))
                    design.status = "ordered"
                    design.is_autosave = False
                    design.save(update_fields=["quantity","design_json","status","is_autosave","updated_at"])
                else:
                    design = SavedDesign(
                        user=request.user if request.user.is_authenticated else None,
                        session_key="" if request.user.is_authenticated else _ensure_session(request),
                        product=product,
                        name=f"{product.name} - Standard order",
                        design_json={"source":"storefront_cart","product_id":product.id},
                        quantity=item["quantity"],
                        status="ordered",
                    )
                    _set_design_storefront_options(design, item.get("size_key", ""), item.get("color_key", ""))
                    design.save()
                order = Order.objects.create(
                    design=design,
                    user=request.user if request.user.is_authenticated else None,
                    customer_name=request.POST["customer_name"].strip(),
                    customer_email=request.POST["customer_email"].strip(),
                    customer_phone=request.POST.get("customer_phone", "").strip(),
                    company=request.POST.get("company", "").strip(),
                    address=request.POST["address"].strip(),
                    city=request.POST["city"].strip(),
                    province=request.POST["province"].strip(),
                    postal_code=request.POST["postal_code"].strip(),
                    quantity=item["quantity"], unit_price=item["unit_price"],
                    total=item["line_total"] - (discount * item["line_total"] / subtotal).quantize(Decimal("0.01")),
                    coupon_code=coupon.code if coupon else "",
                    discount_amount=(discount * item["line_total"] / subtotal).quantize(Decimal("0.01")),
                    customer_notes=request.POST.get("customer_notes", "").strip(),
                    payment_provider="stripe" if cfg.payment_mode == "stripe" else "bypass",
                    payment_status="pending" if cfg.payment_mode == "stripe" else "bypassed",
                )
                send_order_created_emails(order)
                orders.append(order)
            request.session["zenvibe_recent_cart_orders"] = [o.order_number for o in orders]
            if cfg.payment_mode == "stripe" and _stripe_enabled():
                try:
                    return redirect(_create_stripe_cart_session(request, orders))
                except Exception as exc:
                    return render(request, "designer/cart_checkout.html", {**_customer_checkout_context(request), **coupon_context, 
                        "items": items, "subtotal": subtotal, "payment_mode": cfg.payment_mode,
                        "error": f"Stripe checkout could not start: {exc}",
                    })
            for order in orders:
                if cfg.payment_mode == "stripe":
                    order.payment_provider = "bypass"
                    order.payment_status = "bypassed"
                    order.save(update_fields=["payment_provider", "payment_status", "updated_at"])
                sync_order_status(order)
            request.session[CART_SESSION_KEY] = {}
            request.session[CART_DESIGN_MAP_KEY] = {}
            request.session.pop("zv_checkout_coupon", None)
            request.session.modified = True
            return redirect("designer:cart_order_success")
        return render(request, "designer/cart_checkout.html", {**_customer_checkout_context(request), **coupon_context, 
            "items": items, "subtotal": subtotal, "payment_mode": cfg.payment_mode,
            "error": "Please complete all required delivery details.",
        })
    return render(request, "designer/cart_checkout.html", {**_customer_checkout_context(request), **coupon_context, "items": items, "subtotal": subtotal, "payment_mode": cfg.payment_mode})


