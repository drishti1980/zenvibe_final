def ai_assist(request):
    if request.method != "POST":
        return HttpResponseBadRequest("POST required")
    try:
        payload = json.loads(request.body.decode("utf-8"))
        action = payload.get("action", "critique")
        text = (payload.get("text") or "").strip()
        design = payload.get("design") or {}

        if action == "tagline":
            subject = re.sub(r"[^a-zA-Z0-9 '&-]", "", text)[:60] or "your brand"
            options = [
                f"Designed around {subject}",
                f"Make {subject} unforgettable",
                f"Simple ideas. Powerful {subject}.",
                f"Create more with {subject}",
            ]
            return JsonResponse({"ok": True, "result": options})

        pages = design.get("pages") or []
        objects = sum((p.get("objects") or [] for p in pages), [])
        issues = []
        if not objects:
            issues.append("Add at least one text or image element.")
        if len(objects) > 15:
            issues.append("The design may feel crowded; consider reducing the number of elements.")
        tiny_text = [o for o in objects if o.get("type") == "text" and float(o.get("fontSize", 32)) < 14]
        if tiny_text:
            issues.append("Some text is smaller than 14 px and may be difficult to print clearly.")
        transparent = [o for o in objects if float(o.get("opacity", 1)) < 0.35]
        if transparent:
            issues.append("Very transparent elements may not be visible in the final print.")
        if not issues:
            issues.append("The design passes the initial layout and readability review.")
        return JsonResponse({"ok": True, "result": issues})
    except Exception as exc:
        return JsonResponse({"ok": False, "error": str(exc)}, status=400)



