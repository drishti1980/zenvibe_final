def _externalize_template_data_urls(value, template_id, cache=None):
    """Persist generated layer data-URLs to MEDIA storage and replace them with URLs.

    Automatic reconstruction can create many transparent PNG layer images. Keeping
    those base64 payloads inside JSONField makes the database unnecessarily large,
    so save them once as normal media assets.
    """
    from django.core.files.storage import default_storage
    cache = cache if cache is not None else {}
    if isinstance(value, list):
        return [_externalize_template_data_urls(v, template_id, cache) for v in value]
    if isinstance(value, dict):
        return {k: _externalize_template_data_urls(v, template_id, cache) for k, v in value.items()}
    if not (isinstance(value, str) and value.startswith("data:image/") and "," in value):
        return value
    if value in cache:
        return cache[value]
    try:
        header, encoded = value.split(",", 1)
        mime = header[5:].split(";", 1)[0].lower()
        ext = mimetypes.guess_extension(mime) or ".png"
        if ext == ".jpe":
            ext = ".jpg"
        raw = base64.b64decode(encoded)
        digest = hashlib.sha256(raw).hexdigest()[:20]
        name = f"template_layers/template-{template_id}/{digest}{ext}"
        if not default_storage.exists(name):
            default_storage.save(name, ContentFile(raw))
        url = default_storage.url(name)
        cache[value] = url
        return url
    except Exception:
        # Never corrupt a template because one optional generated layer could not
        # be externalised; retain the original source as a safe fallback.
        return value


def _inline_template_media_urls(value):
    """Return template JSON with locally stored media images embedded as data URLs.

    This deliberately trades some response size for reliability. Design masters must
    never disappear just because the site is deployed below /zenvibe/, /client/ or
    another URL prefix. Existing V42-V54 templates may contain absolute MEDIA_URL
    paths such as /zenvibe/media/template_layers/...; those are resolved from the
    configured storage and embedded before the customer editor receives the JSON.
    """
    from django.core.files.storage import default_storage
    from django.conf import settings

    if isinstance(value, list):
        return [_inline_template_media_urls(v) for v in value]
    if isinstance(value, dict):
        return {k: _inline_template_media_urls(v) for k, v in value.items()}
    if not isinstance(value, str) or value.startswith("data:image/"):
        return value

    # Only touch image/media references. Leave normal links/strings unchanged.
    lowered = value.lower().split("?", 1)[0]
    if not lowered.endswith((".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg")):
        return value

    media_url = str(getattr(settings, "MEDIA_URL", "/media/") or "/media/")
    candidates = []
    clean = value.split("?", 1)[0]
    if media_url and clean.startswith(media_url):
        candidates.append(clean[len(media_url):].lstrip("/"))
    # Recover older deployments that persisted an application prefix into MEDIA_URL.
    if "/media/" in clean:
        candidates.append(clean.split("/media/", 1)[1].lstrip("/"))
    candidates.append(clean.lstrip("/"))

    seen = set()
    for name in candidates:
        if not name or name in seen:
            continue
        seen.add(name)
        try:
            if not default_storage.exists(name):
                continue
            with default_storage.open(name, "rb") as fh:
                raw = fh.read()
            mime = mimetypes.guess_type(name)[0] or "image/png"
            return "data:%s;base64,%s" % (mime, base64.b64encode(raw).decode("ascii"))
        except Exception:
            continue
    return value


def visible_categories(top_level=False):
    qs = Category.objects.filter(is_active=True, is_out_of_stock=False)
    if top_level:
        qs = qs.filter(parent__isnull=True)
    return qs


def active_children_prefetch(with_products=False):
    """Never repopulate a parent with inactive children after filtering it."""
    queryset = visible_categories().order_by("sort_order", "name")
    if with_products:
        queryset = queryset.prefetch_related(Prefetch(
            "products",
            queryset=Product.objects.filter(is_active=True, is_out_of_stock=False).order_by("name"),
        ))
    return Prefetch("children", queryset=queryset)


def _is_business_card_product(product):
    if not product:
        return False
    product_name = (product.name or "").lower()
    category = getattr(product, "category", None)
    category_name = (category.name if category else "").lower()
    category_slug = (category.slug if category else "").lower()
    return (
        "business card" in product_name
        or "business card" in category_name
        or "business-card" in category_slug
    )


def _business_card_master_product():
    """
    One shared Business Card template library.

    Templates are physically stored only on Standard Business Cards (#216).
    Premium Business Cards (#1) and Standard Business Cards (#216)
    both display the exact same 100 templates.
    """
    master = Product.objects.filter(id=216).first()

    if master:
        return master

    # Fallback only if product ID changes in another database.
    return (
        Product.objects.filter(
            slug="standard-business-cards"
        ).order_by("id").first()
    )


def _equivalent_template_products(product):
    """Find duplicate catalogue rows representing the same sellable product."""
    from django.db.models import Q
    qs = Product.objects.exclude(id=product.id)
    same_name = qs.filter(name__iexact=product.name)
    slug = (product.slug or "").strip().lower()
    slug_prefix = slug[:40] if len(slug) >= 20 else slug
    same_slug = qs.none()
    if slug_prefix:
        same_slug = qs.filter(Q(slug__iexact=slug) | Q(slug__istartswith=slug_prefix))
    ids = []
    for p in list(same_name.order_by("id")) + list(same_slug.order_by("id")):
        if p.id not in ids:
            ids.append(p.id)
    return ids


def _template_category_ids(product):
    """Return the selected product category and its parent category, if any."""
    if not product or not product.category_id:
        return []
    ids = [product.category_id]
    category = product.category
    if category and category.parent_id:
        ids.append(category.parent_id)
    return list(dict.fromkeys(ids))


def live_templates_for(product):
    """Return only templates that belong to the selected sellable product.

    Business Card products may additionally share the canonical Business Card
    master library. Templates from unrelated products in the same category are
    deliberately NOT included.
    """
    if not product:
        return []

    result, seen_ids, seen_names = [], set(), set()

    def add_templates(queryset):
        for template in queryset:
            name_key = (template.name or "").strip().lower()
            if template.id in seen_ids or (name_key and name_key in seen_names):
                continue
            seen_ids.add(template.id)
            if name_key:
                seen_names.add(name_key)
            result.append(template)

    base = DesignTemplate.objects.select_related(
        "product", "product__category"
    ).filter(is_active=True)

    # 1. Exact selected product.
    add_templates(base.filter(product_id=product.id).order_by("name", "-updated_at", "-id"))

    # 2. Genuine duplicate catalogue rows representing the same product.
    equivalent_ids = _equivalent_template_products(product)
    if equivalent_ids:
        add_templates(
            base.filter(product_id__in=equivalent_ids)
                .order_by("name", "-updated_at", "-id")
        )

    # 3. Business Cards intentionally share one canonical Business Card library.
    if _is_business_card_product(product):
        master = _business_card_master_product()
        if master and master.id != product.id:
            add_templates(
                base.filter(product_id=master.id)
                    .order_by("name", "-updated_at", "-id")
            )

    # IMPORTANT:
    # Never add every template from product.category or its parent category.
    # That was the cause of Business Cards displaying other products' templates.
    return result


def _template_allowed_for_product(template, product):
    """Security check matching live_templates_for(): no category-wide leakage."""
    if not template or not product:
        return False
    if template.product_id == product.id:
        return True
    if template.product_id in _equivalent_template_products(product):
        return True
    if _is_business_card_product(product):
        master = _business_card_master_product()
        if master and template.product_id == master.id:
            return True
    return False


def _get_template_for_product(template_id, product):
    template = get_object_or_404(
        DesignTemplate.objects.select_related("product", "product__category"),
        id=template_id,
        is_active=True,
    )
    if not _template_allowed_for_product(template, product):
        raise Http404("This template is not available for the selected product.")
    return template

def _ensure_session(request):
    if not request.session.session_key:
        request.session.create()
    return request.session.session_key


def _owner_kwargs(request):
    if request.user.is_authenticated:
        return {"user": request.user}
    return {"session_key": _ensure_session(request)}


def _can_access(request, design):
    if request.user.is_staff:
        return True
    if request.user.is_authenticated:
        return design.user_id == request.user.id
    return bool(design.session_key and design.session_key == _ensure_session(request))


