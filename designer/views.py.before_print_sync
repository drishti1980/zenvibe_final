def _stripe_enabled():
    from .models import OrderWorkflowConfig
    from django.conf import settings
    cfg = OrderWorkflowConfig.current()
    site = SiteSettings.current()
    return cfg.payment_mode == "stripe" and bool(settings.STRIPE_SECRET_KEY or site.stripe_secret_key)

def _create_stripe_session(request, order):
    import stripe
    from django.conf import settings
    from .models import OrderWorkflowConfig
    stripe.api_key = settings.STRIPE_SECRET_KEY or SiteSettings.current().stripe_secret_key
    cfg = OrderWorkflowConfig.current()
    success_url = request.build_absolute_uri(reverse("designer:order_success", args=[order.order_number])) + "?session_id={CHECKOUT_SESSION_ID}"
    cancel_url = request.build_absolute_uri(reverse("designer:checkout", args=[order.design_id])) + "?payment=cancelled"
    session = stripe.checkout.Session.create(
        mode="payment",
        client_reference_id=order.order_number,
        customer_email=order.customer_email,
        metadata={"order_number": order.order_number},
        line_items=[{"quantity": order.quantity, "price_data": {
            "currency": cfg.currency.lower(),
            "unit_amount": int(order.unit_price * 100),
            "product_data": {"name": order.design.product.name if order.design and order.design.product else "ZenVibe customised product"},
        }}],
        success_url=success_url,
        cancel_url=cancel_url,
    )
    order.stripe_checkout_session_id = session.id
    order.payment_provider = "stripe"
    order.save(update_fields=["stripe_checkout_session_id", "payment_provider", "updated_at"])
    return session.url

def checkout(request, design_id):
    from decimal import Decimal
    from .models import SavedDesign, Order, OrderWorkflowConfig, OrderStatusHistory
    from .services.order_workflow import send_order_created_emails, sync_order_status
    design = get_object_or_404(SavedDesign.objects.select_related("product"), id=design_id)
    if not _can_access(request, design): return redirect("designer:checkout")
    selected_size_key = _design_selected_size_key(design)
    unit_price = _product_unit_price(design.product, design.quantity, selected_size_key) if design.product else Decimal("0")
    total = unit_price * design.quantity
    cfg = OrderWorkflowConfig.current()
    if request.method == "POST":
        required = ["customer_name", "customer_email", "customer_phone", "company", "address", "city", "province", "postal_code"]
        missing = [x for x in required if not request.POST.get(x, "").strip()]
        if not missing:
            address_error = _canadian_checkout_error(request)
            if address_error:
                return render(request, "designer/checkout.html", {**_customer_checkout_context(request), "error": address_error, "design": design, "unit_price": unit_price, "total": total, "payment_mode": cfg.payment_mode})
            _save_checkout_address(request)
            order = Order.objects.create(
                design=design, user=request.user if request.user.is_authenticated else None,
                customer_name=request.POST["customer_name"].strip(), customer_email=request.POST["customer_email"].strip(),
                customer_phone=request.POST.get("customer_phone", "").strip(), company=request.POST.get("company", "").strip(),
                address=request.POST["address"].strip(), city=request.POST["city"].strip(), province=request.POST["province"].strip(),
                postal_code=request.POST["postal_code"].strip(), quantity=design.quantity, unit_price=unit_price, total=total,
                customer_notes=request.POST.get("customer_notes", "").strip(),
                payment_provider="stripe" if cfg.payment_mode == "stripe" else "bypass",
                payment_status="pending" if cfg.payment_mode == "stripe" else "bypassed",
            )
            design.status = "ordered"; design.save(update_fields=["status", "updated_at"])
            send_order_created_emails(order)
            if cfg.payment_mode == "stripe":
                if not _stripe_enabled():
                    order.payment_provider = "bypass"; order.payment_status = "bypassed"; order.save(update_fields=["payment_provider","payment_status","updated_at"])
                    sync_order_status(order)
                    return redirect("designer:order_success", order_number=order.order_number)
                try:
                    return redirect(_create_stripe_session(request, order))
                except Exception as exc:
                    return render(request, "designer/checkout.html", {**_customer_checkout_context(request), "design":design,"unit_price":unit_price,"total":total,"payment_mode":cfg.payment_mode,"error":f"Stripe checkout could not start: {exc}"})
            sync_order_status(order)
            return redirect("designer:order_success", order_number=order.order_number)
        return render(request, "designer/checkout.html", {**_customer_checkout_context(request), "design":design,"unit_price":unit_price,"total":total,"payment_mode":cfg.payment_mode,"error":"Please complete all required delivery details."})
    return render(request, "designer/checkout.html", {**_customer_checkout_context(request), "design":design,"unit_price":unit_price,"total":total,"payment_mode":cfg.payment_mode})


def order_tracking(request):

    context = {
        "order_number": "",
        "phone": "",
    }

    if request.method == "POST":

        order_number = request.POST.get(
            "order_number",
            ""
        ).strip()

        phone = request.POST.get(
            "phone",
            ""
        ).strip()

        context["order_number"] = order_number
        context["phone"] = phone


        if not order_number or not phone:

            context["error"] = (
                "Please enter both your order ID "
                "and phone number."
            )

            return render(
                request,
                "designer/order_tracking.html",
                context
            )


        # IMPORTANT:
        # Replace customer_phone below only if your Order model
        # uses a different phone field name.
        order = (
            Order.objects
            .filter(
                order_number__iexact=order_number,
                customer_phone=phone,
            )
            .first()
        )


        if not order:

            context["error"] = (
                "We could not find an order matching "
                "that order ID and phone number."
            )

            return render(
                request,
                "designer/order_tracking.html",
                context
            )


        # Save this verified order in the session before redirecting.
        verified_orders = request.session.get(
            "verified_tracking_orders",
            []
        )

        if order.order_number not in verified_orders:
            verified_orders.append(
                order.order_number
            )

        request.session[
            "verified_tracking_orders"
        ] = verified_orders

        request.session.modified = True


        # DO NOT redirect to my_orders.
        # Redirect to the dedicated tracking result page.
        return redirect(
            "designer:order_tracking_result",
            order_number=order.order_number,
        )


    return render(
        request,
        "designer/order_tracking.html",
        context
    )



