{% extends 'designer/base.html' %}
{% load static %}
{% block title %}Design Studio · {{ product.name }}{% endblock %}
{% block head %}
<script>
document.documentElement.classList.add('editor-document');
window.PRODUCT={id:{{ product.id }},name:"{{ product.name|escapejs }}",width:{{ product.width }},height:{{ product.height }},minDpi:{{ product.min_dpi }},bleedMm:{{ product.bleed_mm }},safeMarginMm:{{ product.safe_margin_mm }}};
window.INITIAL_TEMPLATE={{ template_json|safe }};
window.TEMPLATE_IMAGE="{% if template_image %}{{ template_image }}{% endif %}";
window.SOURCE_TEMPLATE_ID={% if template %}{{ template.id }}{% else %}null{% endif %};
window.PACK_TEMPLATE_ID="{{ pack_code|default:''|escapejs }}";
window.TEMPLATE_UPDATED_AT={% if template and template.updated_at %}{{ template.updated_at.timestamp|floatformat:0 }}000{% else %}null{% endif %};
window.TEMPLATE_CATALOG={{ template_catalog_json|safe }};
window.ZENVIBE_STATIC_URL="{% static '' %}";
window.EXISTING_DESIGN={id:{% if existing_design %}{{ existing_design.id }}{% else %}null{% endif %},name:"{% if existing_design %}{{ existing_design.name|escapejs }}{% endif %}",quantity:{% if existing_design %}{{ existing_design.quantity }}{% else %}100{% endif %}};
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.0/fabric.min.js"></script>
<script src="{% static 'designer/js/image-tools.js' %}"></script>
<script src="{% static 'designer/js/vector-upload.js' %}"></script>
<script src="{% static 'designer/js/raster-edit-tools.js' %}"></script>
<script src="{% static 'designer/js/arrange-tools.js' %}"></script>
<link rel="stylesheet" href="{% static 'designer/css/image-tools.css' %}">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.2/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
<script defer src="{% static 'designer/js/editor.js' %}"></script>
<script defer src="{% static 'designer/js/editor-enhancements.js' %}"></script>
<script defer src="{% static 'designer/js/canva-pro.js' %}"></script>
{% endblock %}
{% block content %}
<div class="studio-app editor-shell">
  <header class="studio-topbar">
    <div class="studio-brand-group">
      <a class="studio-back" href="{% url 'designer:choose_design' product.id %}" aria-label="Back">←</a>
      <a class="studio-logo" href="/">Z<span>ENVIBE</span></a>
      <div class="studio-file-menu"><button id="fileMenuBtn">File</button></div><div class="studio-file-meta">
        <input id="designName" value="{% if existing_design %}{{ existing_design.name }}{% else %}My Zenvibe Design{% endif %}" aria-label="Design name">
        <small>{{ product.name }} · {{ product.width }} × {{ product.height }} px</small>
      </div>
    </div>
    <div class="studio-history-actions">
      <button id="undoBtn" class="icon-command" title="Undo (Ctrl+Z)">↶</button>
      <button id="redoBtn" class="icon-command" title="Redo (Ctrl+Y)">↷</button>
      <span id="autosaveStatus" class="autosave-status">Ready</span>
    </div>
    <div class="studio-primary-actions">
      <button id="downloadBtn" class="studio-secondary">Download</button>
      <button id="saveDraftBtn" class="studio-secondary">Save</button>
      <button id="saveBtn" class="studio-share">Continue to cart</button>
    </div>
  </header>

  <aside class="studio-rail" aria-label="Design tools">
    <button class="rail-tab active" data-panel="templatesPanel"><span>▦</span><b>Templates</b></button>
    <button class="rail-tab" data-panel="elementsPanel"><span>◈</span><b>Elements</b></button>
    <button class="rail-tab" data-panel="textPanel"><span>T</span><b>Text</b></button>
    <button class="rail-tab" data-panel="uploadsPanel"><span>⇧</span><b>Uploads</b></button>
    <button class="rail-tab" data-panel="iconsPanel"><span>✦</span><b>Icons</b></button>
    <button class="rail-tab" data-panel="photosPanel"><span>▣</span><b>Photos</b></button>
    <button class="rail-tab" data-panel="toolsPanel"><span>⌘</span><b>Tools</b></button>
    <button class="rail-tab" data-panel="emojiPanel"><span>☺</span><b>Emoji</b></button>
    <button class="rail-tab" data-panel="backgroundPanel"><span>▧</span><b>Background</b></button>
    <button class="rail-tab" data-panel="layersPanelWrap"><span>☷</span><b>Layers</b></button>
  </aside>

  <aside class="studio-panel editor-sidebar">
    <div class="panel-heading"><div><small>DESIGN STUDIO</small><h2 id="panelTitle">Templates</h2></div><button id="closePanelBtn" aria-label="Close panel">×</button></div>

    <section id="templatesPanel" class="studio-panel-section active">
      <div class="panel-search"><span>⌕</span><input id="templateSearch" placeholder="Search templates" aria-label="Search templates" autocomplete="off"></div>
      <div id="templateSuggestions" class="template-suggestions"></div>
      <div class="panel-callout"><strong>Master template protected</strong><p>Your edits are saved as a personal copy. The admin template is never changed.</p></div>
      <div class="panel-callout" style="background:#fff8ed;border-color:#f3d9a8">
        <strong style="color:#7a5a17">Seeing an old version?</strong>
        <p>Your browser may have a saved draft from an earlier session.</p>
        <button type="button" id="clearLocalDraftBtn" style="width:100%;margin-top:6px;padding:8px;border-radius:8px;border:1px solid #f3d9a8;background:#fff;font-weight:700;cursor:pointer">Clear my saved draft &amp; reload</button>
      </div>
      <h3>Pages</h3><div id="pageButtons" class="page-list"></div>
      <div class="two-col"><button id="addPageBtn">＋ Add page</button><button id="duplicatePageBtn">Duplicate</button></div>
      <button id="deletePageBtn" class="danger ghost-command">Delete current page</button>
    </section>

    <section id="elementsPanel" class="studio-panel-section">
      <div class="panel-search"><span>⌕</span><input id="elementSearch" placeholder="Search shapes and lines" aria-label="Search elements"></div>
      <h3>Lines &amp; shapes</h3>
      <div id="shapeLibrary" class="asset-grid shape-grid">
        <button data-shape="rect" title="Rectangle"><span class="shape-preview shape-square"></span></button>
        <button data-shape="roundRect" title="Rounded rectangle"><span class="shape-preview shape-rounded"></span></button>
        <button data-shape="circle" title="Circle"><span class="shape-preview shape-circle"></span></button>
        <button data-shape="ellipse" title="Ellipse"><span class="shape-preview shape-ellipse"></span></button>
        <button data-shape="triangle" title="Triangle"><span class="shape-preview shape-triangle"></span></button>
        <button data-shape="diamond" title="Diamond"><span class="shape-preview shape-diamond"></span></button>
        <button data-shape="pentagon" title="Pentagon"><span class="shape-preview">⬟</span></button>
        <button data-shape="hexagon" title="Hexagon"><span class="shape-preview">⬢</span></button>
        <button data-shape="star" title="Star"><span class="shape-preview">★</span></button>
        <button data-shape="heart" title="Heart"><span class="shape-preview">♥</span></button>
        <button data-shape="arrowRight" title="Arrow"><span class="shape-preview">➜</span></button>
        <button data-shape="speech" title="Speech bubble"><span class="shape-preview">▰</span></button>
        <button data-shape="line" title="Line"><span class="shape-preview">━</span></button>
        <button data-shape="dashLine" title="Dashed line"><span class="shape-preview">┅</span></button>
        <button data-shape="wave" title="Wave"><span class="shape-preview">〰</span></button>
        <button data-shape="cross" title="Cross"><span class="shape-preview">✚</span></button>
      </div>
      <h3>Quick add</h3>
      <div class="three-col legacy-adders"><button id="addRectBtn">Rectangle</button><button id="addCircleBtn">Circle</button><button id="addTriangleBtn">Triangle</button></div>
    </section>

    <section id="textPanel" class="studio-panel-section">
      <button id="addTextBtn" class="big-text-command">＋ Add a text box</button>
      <button class="text-preset" data-text-preset="heading"><strong>Add a heading</strong></button>
      <button class="text-preset" data-text-preset="subheading"><span>Add a subheading</span></button>
      <button class="text-preset" data-text-preset="body"><small>Add a little bit of body text</small></button>
      <h3>Font</h3>
      <select id="fontPanelSelect" class="zv-font-dropdown" aria-label="Choose font"><option value="">Choose a font</option></select>
      <h3>Text colour</h3>
      <label class="colour-row"><input id="textPanelColor" type="color" value="#111827"><span><strong>Any text colour</strong><small id="textPanelHex">#111827</small></span></label><input id="textPanelHexInput" value="#111827" maxlength="7" placeholder="#RRGGBB" style="margin-top:7px;text-transform:uppercase;font-family:monospace">
      <div id="textColourSwatches" class="swatch-grid text-colour-swatches"></div>
      <p class="panel-help">Select or double-click template text, then choose a colour. Detected printed text is converted to a real editable text layer when you change it.</p>
    </section>

    <section id="uploadsPanel" class="studio-panel-section">
      <label class="upload-dropzone">📷<strong>Upload / take a photo</strong><span>PNG, JPG, WebP or SVG up to 15 MB</span><input id="imageUpload" type="file" accept="image/*,.svg" multiple hidden></label>
      <div class="upload-note">Uploaded images remain inside the customer's saved design.</div>

      <div class="tool-card" style="margin-top:14px">
        <strong>Use my own photo as a background</strong>
        <p style="font-size:12px;color:#667085;margin:6px 0 10px">Upload a photo, lock it in place, then drop an editable text box on top — same idea as our template builder, but this only affects your own design. Nothing here is saved to the shared template library.</p>
        <label class="upload-dropzone" style="margin-bottom:8px">📷<strong>Upload / take background photo</strong><input id="bgPhotoUpload" type="file" accept="image/*" hidden></label>
        <button type="button" id="addEditableTextBtn" class="primary-action" style="width:100%">+ Add editable text on top</button>
      </div>
    </section>


    <section id="iconsPanel" class="studio-panel-section">
      <div class="panel-search"><span>⌕</span><input id="iconSearch" placeholder="Search icons" aria-label="Search icons"></div>
      <div id="iconCategories" class="asset-chip-row"></div>
      <div id="iconLibrary" class="asset-grid icon-grid"></div>
    </section>

    <section id="photosPanel" class="studio-panel-section">
      <div class="panel-search"><span>⌕</span><input id="photoSearch" placeholder="Search attractive photos, gradients and patterns" aria-label="Search photos"></div>
      <div id="photoLibrary" class="photo-grid"></div>
      <p class="panel-help">Choose Add photo for an editable image, or Use as background to fill the full page. All changes remain inside the customer's personal design.</p>
    </section>

    <section id="toolsPanel" class="studio-panel-section">
      <h3>Quick tools</h3>
      <div id="quickToolStrip" class="zv-quick-tools" aria-label="Editor tools">
        <button type="button" data-quick-tool="select" title="Select">➤<small>Select</small></button>
        <button type="button" data-quick-tool="draw" title="Draw">✎<small>Draw</small></button>
        <button type="button" data-quick-tool="shape" title="Add shape">●<small>Shape</small></button>
        <button type="button" data-quick-tool="line" title="Add line">╱<small>Line</small></button>
        <button type="button" data-quick-tool="note" title="Sticky note">◩<small>Note</small></button>
        <button type="button" data-quick-tool="text" title="Add text">T<small>Text</small></button>
        <button type="button" data-quick-tool="signature" title="Draw signature">〰<small>Sign</small></button>
        <button type="button" data-quick-tool="table" title="Add table">▦<small>Table</small></button>
      </div>
      <h3>Printed text</h3>
      <div class="tool-card">
        <strong>Remove / Replace printed text</strong>
        <p class="panel-help">For flattened PNG/JPG or camera photos: drag a tight box over any printed name/date/text. ZenVibe removes the old raster lettering first, then creates a normal editable text layer. This is the reliable mode for script fonts and does not depend on OCR.</p>
        <button type="button" id="replacePrintedTextBtn" class="primary-action" style="width:100%">Edit / Replace printed text</button>
        <button type="button" id="cancelReplacePrintedTextBtn" style="width:100%;margin-top:7px;display:none">Cancel</button>
        <small id="replacePrintedTextStatus" style="display:block;margin-top:7px;color:#667085"></small>
      </div>
      <h3>Design tools</h3>
      <div class="tool-card"><strong>QR code</strong><input id="qrValue" value="https://zenvibe.ca" placeholder="URL or text"><button id="addQrBtn">Add QR code</button></div>
      <div class="tool-card"><strong>Barcode</strong><input id="barcodeValue" value="123456789012" placeholder="Barcode value"><button id="addBarcodeBtn">Add barcode</button></div>
      <div class="tool-card"><strong>Canvas guides</strong><button id="toggleRulersBtn">Show/hide rulers</button><button id="clearGuidesBtn">Clear draggable guides</button></div>
      <div class="tool-card"><strong>Object position</strong><div class="position-grid"><label>X<input id="positionX" type="number"></label><label>Y<input id="positionY" type="number"></label><label>W<input id="positionW" type="number"></label><label>H<input id="positionH" type="number"></label></div><button id="applyPositionBtn">Apply position &amp; size</button></div>
    </section>

    <section id="emojiPanel" class="studio-panel-section">
      <div class="panel-search"><span>⌕</span><input id="emojiSearch" placeholder="Search emoji" aria-label="Search emoji"></div>
      <div id="emojiLibrary" class="emoji-grid"></div>
    </section>

    <section id="backgroundPanel" class="studio-panel-section">
      <h3>Document background</h3><p class="panel-help">Changes the page colour. For flat PNG/JPG templates, ZenVibe also recolours the dominant paper/background area while preserving artwork and text as much as possible. The background artwork itself is selectable from Layers for crop, blur, resize and other image edits.</p><label class="colour-row document-colour-control"><input id="backgroundColor" type="color" value="#ffffff"><span><strong>Page colour</strong><small id="backgroundHex">#FFFFFF</small></span></label><button id="applyBackgroundBtn">Apply page colour</button>
      <h3>Colour presets</h3><div id="backgroundSwatches" class="swatch-grid"></div>
      <div class="tool-card artwork-colour-card">
        <strong>Artwork / floral colour</strong>
        <p class="panel-help">Select the uploaded artwork layer in Layers, then adjust the colourful parts of a flat PNG/JPG. Light paper and neutral black/grey text are preserved as much as possible.</p>
        <label class="slider-label">Hue <span id="artHueVal">0°</span></label><input id="artHue" type="range" min="-180" max="180" value="0">
        <label class="slider-label">Saturation <span id="artSaturationVal">100%</span></label><input id="artSaturation" type="range" min="0" max="200" value="100">
        <label class="slider-label">Brightness <span id="artBrightnessVal">100%</span></label><input id="artBrightness" type="range" min="50" max="150" value="100">
        <label class="slider-label">Contrast <span id="artContrastVal">100%</span></label><input id="artContrast" type="range" min="50" max="150" value="100">
        <label class="colour-row" style="margin-top:8px"><input id="artTint" type="color" value="#8b5cf6"><span><strong>Tint colour</strong><small>Optional</small></span></label>
        <label class="slider-label">Tint strength <span id="artTintStrengthVal">0%</span></label><input id="artTintStrength" type="range" min="0" max="100" value="0">
        <div class="two-col" style="margin-top:8px"><button id="applyArtworkColourBtn">Apply artwork colour</button><button id="resetArtworkColourBtn">Reset</button></div>
        <hr style="border:0;border-top:1px solid #e5e7eb;margin:14px 0">
        <strong>Decorative artwork</strong>
        <p class="panel-help">For a flattened PNG/JPG, remove colourful floral/decorative pixels while keeping the light paper and dark text as much as possible. You can restore them at any time.</p>
        <label class="slider-label">Removal strength <span id="decorRemovalVal">72%</span></label>
        <input id="decorRemovalStrength" type="range" min="35" max="95" value="72">
        <div class="two-col" style="margin-top:8px"><button id="removeDecorBtn" class="danger">Remove floral / design</button><button id="restoreDecorBtn">Restore artwork</button></div>
      </div>
      <h3>View</h3><label class="check-row"><input id="snapToggle" type="checkbox" checked> Smart alignment guides</label>
      <div class="three-col"><button id="fitBtn" title="Fit the whole page inside the available workspace">Fit</button><button id="gridBtn" title="Show or hide the alignment grid">Grid</button><button id="guidesBtn" title="Show print trim, bleed and safe margins">Safe/Bleed</button></div>
      <div class="view-legend"><span><i class="legend-grid"></i>Grid helps alignment</span><span><i class="legend-bleed"></i>Red: trim/bleed</span><span><i class="legend-safe"></i>Green: safe area</span></div>
    </section>

    <section id="layersPanelWrap" class="studio-panel-section">
      <div class="two-col"><button id="showAllBtn">Show all</button><button id="unlockAllBtn">Unlock all</button></div>
      <div id="layersPanel" class="layers-panel modern-layers"></div>
    </section>

    <section class="studio-hidden-legacy" aria-hidden="true">
      <button id="fullscreenBtn"></button><input id="zoomRange" type="range" min="20" max="180" value="100"><select id="zoomSelect"><option value="100" selected>100%</option></select><button id="zoomOutBtn"></button><button id="zoomInBtn"></button>
      <div id="printResults"></div><input id="quantity" type="number" min="1" value="{% if existing_design %}{{ existing_design.quantity }}{% else %}100{% endif %}"><button id="downloadPdfBtn"></button><button id="discardBtn"></button><p id="saveStatus"></p>
    </section>
  </aside>

  <main class="canvas-area studio-workspace">
    <div id="contextToolbar" class="context-toolbar">
      <div class="context-empty">Select an element to edit it</div>
      <div class="context-controls">
        <select id="fontFamily" title="Font family"></select>
        <input id="fontSize" type="number" min="6" max="300" value="32" title="Font size">
        <button id="boldBtn" title="Bold"><b>B</b></button><button id="italicBtn" title="Italic"><i>I</i></button><button id="underlineBtn" title="Underline"><u>U</u></button>
        <label class="toolbar-colour" title="Fill"><input id="fillColor" type="color" value="#111827"><span></span></label>
        <input id="textValue" placeholder="Text content" aria-label="Text content"><button id="applyTextBtn">Apply</button>
        <button id="editImageBtn" style="display:none">Edit image</button><button id="duplicateBtn">Duplicate</button><button id="lockBtn">Lock</button><button id="deleteBtn" class="danger">Delete</button>
        <input id="opacity" type="range" min="0.05" max="1" step="0.05" value="1" title="Opacity"><input id="rotation" type="range" min="-180" max="180" step="1" value="0" title="Rotation">
      </div>
      <div class="context-more arrange-dropdown" id="arrangeDropdown">
        <button type="button" id="arrangeMenuBtn" class="arrange-menu-trigger" aria-expanded="false">Arrange <span>⌄</span></button>
        <div class="arrange-menu" id="arrangeMenu" role="menu">
          <div class="arrange-menu-heading">Align horizontally</div>
          <div class="arrange-menu-grid three">
            <button id="leftBtn" role="menuitem">Left</button><button id="centerBtn" role="menuitem">Centre</button><button id="rightBtn" role="menuitem">Right</button>
          </div>
          <div class="arrange-menu-heading">Align vertically</div>
          <div class="arrange-menu-grid three">
            <button id="topBtn" role="menuitem">Top</button><button id="middleBtn" role="menuitem">Middle</button><button id="bottomBtn" role="menuitem">Bottom</button>
          </div>
          <div class="arrange-menu-heading">Layer order</div>
          <div class="arrange-menu-grid two">
            <button id="bringFrontBtn" role="menuitem">Bring forward</button><button id="sendBackBtn" role="menuitem">Send backward</button>
          </div>
          <div class="arrange-menu-heading">Transform</div>
          <div class="arrange-menu-grid two">
            <button id="flipXBtn" role="menuitem">Flip horizontal</button><button id="flipYBtn" role="menuitem">Flip vertical</button>
          </div>
          <button id="groupBtn" class="arrange-menu-wide" role="menuitem">Group / Ungroup selection</button>
        </div>
      </div>
    </div>
    <div class="studio-canvas-scroll">
      <div class="canvas-stage">
        <div id="horizontalRuler" class="canvas-ruler horizontal-ruler"></div><div id="verticalRuler" class="canvas-ruler vertical-ruler"></div>
        <div id="measurementBadge" class="measurement-badge" hidden></div><div id="smartGuideLayer" class="smart-guide-layer"></div><div class="canvas-wrap" id="canvasWrap"><canvas id="designCanvas"></canvas>
          <div id="noEditableHint" style="display:none;position:absolute;left:50%;bottom:16px;transform:translateX(-50%);background:#101828;color:#fff;padding:12px 16px;border-radius:12px;box-shadow:0 12px 30px rgba(16,24,40,.35);align-items:center;gap:12px;font:600 13px Inter,Arial,sans-serif;z-index:50">
            <span>This template doesn't have editable text yet.</span>
            <button type="button" onclick="addQuickEditableText()" style="background:linear-gradient(135deg,#ff6a1a,#ff8a3d);color:#fff;border:0;border-radius:8px;padding:8px 14px;font-weight:700;cursor:pointer">+ Add text</button>
          </div>
        </div>
      </div>
    </div>
    <footer class="studio-bottom-bar">
      <div class="page-status"><strong id="activePageLabel">Page 1</strong><span>Changes save to your personal design only</span></div>
      <div class="zoom-controls"><button id="bottomZoomOut">−</button><input id="bottomZoomRange" type="range" min="20" max="180" value="100"><button id="bottomZoomIn">＋</button><span id="zoomLabel">100%</span></div>
    </footer>
  </main>
</div>

<div id="studioToast" class="studio-toast" role="status" aria-live="polite"></div>
<div id="studioModal" class="studio-modal" aria-hidden="true">
  <div class="studio-modal-backdrop" data-close-modal></div>
  <section class="studio-modal-card" role="dialog" aria-modal="true" aria-labelledby="studioModalTitle">
    <header><div><small>DESIGN REVIEW</small><h2 id="studioModalTitle">Print check</h2></div><button id="studioModalClose" aria-label="Close">×</button></header>
    <div id="studioModalBody" class="studio-modal-body"></div>
    <footer><button id="studioModalDone" class="studio-share">Done</button></footer>
  </section>
</div>
{% endblock %}
