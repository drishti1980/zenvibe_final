<!-- =========================================================
     SHOP BY CATEGORY
     Uses Multikart's exact "Fashion for you" classic-effect
     + slide-3 Slick structure
========================================================= -->

<div class="container">
    <div class="row">
        <div class="col">
            <div class="title1 section-t-space">
                <h4>Shop by Category</h4>
                <h2 class="title-inner1">Find Your Perfect Product</h2>
            </div>
        </div>
    </div>
</div>

<section class="blog pt-0 ratio2_3 zv-category-fashion-section">
    <div class="container">
        <div class="row">
            <div class="col-md-12">

                <!-- Same slider classes used by Multikart "Fashion for you" -->
                <div class="slide-3 no-arrow slick-default-margin zv-category-fashion-slider">

                    {% for c in categories|slice:':10' %}

                    <div class="col-md-12">

                        <a href="{% url 'designer:category_detail' c.slug %}"
                           class="zv-fashion-category-card">

                            <!-- Exact Multikart classic-effect structure -->
                            <div class="classic-effect zv-category-classic-effect">

                                <div class="zv-category-fashion-image">

                                    {% if c.image %}

                                    <img
                                        src="{{ c.image.url }}"
                                        class="img-fluid blur-up lazyload"
                                        alt="{{ c.name }}">

                                    {% else %}

                                        {% with p=c.products.first %}

                                            {% if p.image %}

                                            <img
                                                src="{{ p.image.url }}"
                                                class="img-fluid blur-up lazyload"
                                                alt="{{ c.name }}">

                                            {% else %}

                                            <div class="zv-category-placeholder">
                                                <span>{{ c.name|slice:":1" }}</span>
                                            </div>

                                            {% endif %}

                                        {% endwith %}

                                    {% endif %}

                                </div>

                                <!-- Required by Multikart classic-effect.
                                     Its ::before and ::after create the
                                     3rd and 4th animated overlay panels. -->
