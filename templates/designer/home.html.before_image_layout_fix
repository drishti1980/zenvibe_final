{% extends 'designer/base.html' %}
{% load static %}

{% block title %}ZenVibe Corporate Gifts Canada | Custom Promotional Products{% endblock %}

{% block content %}


<!-- =========================================================
     HOME SLIDER - ADMIN CONTROLLED
========================================================= -->

<section class="p-0">
    <div class="slide-1 home-slider">

        {% if home_banners %}
            {% for banner in home_banners %}
            <div>
                <a class="home zv-home-slide zv-admin-home-banner"
                   href="{{ banner.button_url|default:'#' }}"
                   data-text-align="{{ banner.text_alignment|default:'left'|lower }}">

                    {% if banner.image %}
                    <picture>
                        {% if banner.mobile_image %}
                        <source media="(max-width: 767px)" srcset="{{ banner.mobile_image.url }}">
                        {% endif %}
                        <img src="{{ banner.image.url }}"
                             alt="{{ banner.title|default:'ZenVibe' }}"
                             class="bg-img blur-up lazyload">
                    </picture>
                    {% endif %}

                    <div class="zv-hero-copy zv-align-{{ banner.text_alignment|default:'left'|lower }}">
                        {% if banner.title %}
                        <h1 class="zv-hero-title">{{ banner.title }}</h1>
                        {% endif %}

                        {% if banner.subtitle %}
                        <div class="zv-hero-subtitle">{{ banner.subtitle }}</div>
                        {% endif %}

                        
                        {% if banner.button_text %}
                        <span class="btn btn-solid zv-hero-button">
                            {{ banner.button_text }}
                        </span>
                        {% endif %}
                    </div>

                </a>
            </div>
            {% endfor %}

        {% else %}
            {# Safe fallback if there are no active HomeBanner records. #}
            {% for p in products|slice:':2' %}
            <div>
                <a class="home zv-home-slide"
                   href="{% url 'designer:choose_design' p.id %}">
                    {% if p.image %}
                    <img src="{{ p.image.url }}"
                         alt="{{ p.name }}"
                         class="bg-img blur-up lazyload">
                    {% endif %}
                </a>
            </div>
            {% empty %}
            <div>
                <a class="home zv-home-slide zv-admin-home-banner"
                   href="{% url 'designer:start_designing' %}">
                    <div class="zv-hero-copy zv-align-left">
                        <div class="zv-hero-subtitle">ZenVibe</div>
                        <h1 class="zv-hero-title">Custom Products</h1>
                        <span class="btn btn-solid zv-hero-button">Shop Now</span>
                    </div>
                </a>
            </div>
            {% endfor %}
        {% endif %}

    </div>
</section>


<!-- =========================================================
     COLLECTION BANNERS
========================================================= -->

<section class="pb-0 banner-section">

    <div class="container">

        <div class="row partition2">

            {% for c in categories|slice:':2' %}

            <div class="col-md-6">

                <a class="collection-banner zv-clean-collection {% if forloop.first %}zv-clean-business{% else %}zv-clean-invitation{% endif %}"
                   href="{% url 'designer:category_detail' c.slug %}">

                    <div class="zv-clean-copy">

                        <span class="zv-clean-eyebrow">
                            {% if forloop.first %}
                                PROFESSIONAL PRINTING
                            {% else %}
                                MADE FOR SPECIAL MOMENTS
                            {% endif %}
                        </span>

                        <h2>{{ c.name }}</h2>

                        <p>
                            {% if forloop.first %}
                                Premium custom cards designed to make your brand look polished and memorable.
                            {% else %}
                                Beautiful custom invitations for weddings, events, celebrations and more.
                            {% endif %}
                        </p>

                        <span class="zv-clean-link">
                            Shop Collection
                            <i class="ri-arrow-right-line"></i>
                        </span>

                    </div>

                    <div class="zv-clean-image">

                        {% if c.image %}
                        <img src="{{ c.image.url }}"
                             alt="{{ c.name }}"
                             class="img-fluid blur-up lazyload">
                        {% endif %}

                    </div>

                    <span class="zv-clean-accent"></span>

                </a>

            </div>

            {% endfor %}

        </div>

    </div>

</section>


<!-- =========================================================
     TOP COLLECTION TITLE
========================================================= -->

<div class="title1 section-t-space">
    <h4>Special Offer</h4>
    <h2 class="title-inner1">Top Collection</h2>
</div>


<!-- =========================================================
     TOP COLLECTION PRODUCTS
========================================================= -->

<section class="section-b-space pt-0 ratio_asos">

    <div class="container">

        <div class="g-3 g-md-4 row row-cols-2 row-cols-md-3 row-cols-xl-4">

            {% for product in products|slice:':4' %}

            <div>

                <div class="basic-product theme-product-1">

                    <div class="overflow-hidden">

                        <!-- PRODUCT IMAGE -->
                        <div class="img-wrapper position-relative">


                            <!-- EXCLUSIVE RIBBON -->
                             {% if forloop.counter <= 2 %}
                            <div class="zv-exclusive-ribbon">
                                <span>Exclusive</span>
                            </div>
                            {% endif %}


                            <!-- SALE RIBBON -->
                            {% if product.is_on_sale %}
                            <div class="ribbon">
                                <span>Sale</span>
                            </div>
                            {% endif %}


                            <!-- IMAGE -->
                            <a href="{% url 'designer:choose_design' product.id %}">

                                {% if product.image %}
                                <img src="{{ product.image.url }}"
                                     class="img-fluid zv-product-img"
                                     alt="{{ product.name }}">
                                {% endif %}

                            </a>


                            <!-- RATING -->
                            <!-- <div class="rating-label">
                                <i class="ri-star-fill"></i>
                                <span>4.5</span>
                            </div> -->


                            <!-- HOVER ACTIONS -->
                            <div class="cart-info">

                                <!-- Wishlist -->
                                <!-- <a href="#!"
                                   class="wishlist-icon"
                                   data-wishlist
                                   data-id="{{ product.id }}"
                                   data-name="{{ product.name|escape }}"
                                   data-price="{{ product.sale_price|default:product.price }}"
                                   data-image="{% if product.image %}{{ product.image.url }}{% endif %}"
                                   data-url="{% url 'designer:choose_design' product.id %}"
                                   title="Add to Wishlist">

                                    <i class="ri-heart-line"></i>

                                </a> -->


                                <!-- Add To Cart -->
                                <button type="button"
                                        data-add-cart
                                        data-product-id="{{ product.id }}"
                                        data-product-name="{{ product.name|escape }}"
                                        data-product-price="{{ product.sale_price|default:product.price }}" data-product-image="{% if product.image %}{{ product.image.url }}{% endif %}" data-product-url="{% url 'designer:choose_design' product.id %}" data-cart-url="{% url 'designer:add_to_cart' product.id %}"
                                        title="Add to Cart">

                                    <i class="ri-shopping-cart-line"></i>

                                </button>


                                <!-- Quick View -->
                                <a href="#!"
                                   data-quick-view
                                   data-id="{{ product.id }}"
                                   data-name="{{ product.name|escape }}"
                                   data-description="{{ product.short_description|striptags|escape }}"
                                   data-price="{{ product.sale_price|default:product.price }}"
                                   data-image="{% if product.image %}{{ product.image.url }}{% endif %}"
                                   data-url="{% url 'designer:choose_design' product.id %}"
                                   data-cart-url="{% url 'designer:add_to_cart' product.id %}"
                                   title="Quick View">

                                    <i class="ri-eye-line"></i>

                                </a>

                            </div>

                        </div>


                        <!-- PRODUCT INFORMATION -->
                        <div class="product-detail">

                            <div>

                                <div class="brand-w-color">

                                    <a class="product-title"
                                       href="{% url 'designer:choose_design' product.id %}">

                                        {{ product.name }}

                                    </a>

                                </div>


                                <h6>
                                    {{ product.category.name }}
                                </h6>


                                <!-- PRICE -->
                                <h4 class="price">

                                    {% if product.is_on_sale and product.sale_price %}

                                        ${{ product.sale_price }}

                                        <del>
                                            ${{ product.price }}
                                        </del>

                                    {% else %}

                                        ${{ product.price }}

                                    {% endif %}

                                </h4>

                            </div>


                            <!-- ONE BUTTON ONLY -->
                            <div class="zv-one-action">

                                <a href="{% url 'designer:choose_design' product.id %}"
                                   class="btn btn-solid">

                                    Customize &amp; Add to Cart

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            {% empty %}

            <div class="col-12 text-center py-5">
                <h4>No products available.</h4>
            </div>

            {% endfor %}

        </div>

    </div>

</section>


