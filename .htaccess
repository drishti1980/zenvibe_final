# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/utwsig55/public_html/demo_portal/zenvibe"
PassengerBaseURI "/zenvibe"
PassengerPython "/home/utwsig55/virtualenv/public_html/demo_portal/zenvibe/3.10/bin/python"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
RewriteEngine On
# Serve static files
RewriteRule ^static/(.*)$ staticfiles/$1 [L]
# Serve media files
RewriteRule ^media/(.*)$ media/$1 [L]
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
SetEnv ZENVIBE_URL_PREFIX zenvibe
SetEnv DEMO_PORTAL_MODE 1
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END
# Zenvibe: UTF-8 encoding for JavaScript
<IfModule mod_mime.c>
    AddCharset UTF-8 .js
</IfModule>
